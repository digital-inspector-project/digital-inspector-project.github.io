                "display": "flex",
                "flex-wrap": "wrap",
                "& .btn": {
                  "width": "auto"
                }
              }
            },
            ".col-img": {
              "width": "100%",
              "max-width": "45%",
              "@media (max-width: 767px)": {
                "max-width": "100%"
              }
            },
            ".img-container": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "flex-end",
              "width": "100%",
              "height": "100%",
              "img": {
                "max-width": "100%",
                "max-height": "100%",
