    "global_footer_custom": "<script>\n  if (window.location.pathname.endsWith('.html')) {\n      window.history.replaceState({}, '', window.location.pathname.replace('.html', ''));\n  }\n</script>\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n\n  // Sprawdź, czy adres URL zawiera znak zapytania \"?\" LUB hash \"#\"\n  if (window.location.search || window.location.hash) {\n    \n    // Znajdź wszystkie kontenery pop-upów Mobirise\n    const mobirisePopups = document.querySelectorAll('.mbr-popup');\n    \n    // Przejdź przez każdy znaleziony pop-up\n    mobirisePopups.forEach(function(popup) {\n      // Zamiast usuwać cały pop-up, usuwamy z niego tylko atrybut,\n      // który mówi skryptom Mobirise, aby go pokazały przy przewijaniu.\n      popup.removeAttribute('data-on-scroll');\n    });\n  }\n});\n</script>\n"
