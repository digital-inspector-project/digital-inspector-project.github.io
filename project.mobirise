        {
          "_name": "clients03",
          "_sourceTheme": "conceptm4",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "img": {
              "width": "150px",
              "margin": "auto",
              "margin-top": "5rem",
              "filter": "invert(1) brightness(5) blur(0.5px)"
            },
            ".container-fluid": {
              "padding": "0 1rem"
            },
            ".card": {
              "transition": "all 0.3s",
              "height": "auto",
              "padding": "3rem 1rem",
              "opacity": "1",
              "border-radius": "0"
            },
            ".card1": {
              "background-color": "@card1"
            },
            ".card2": {
              "background-color": "@card2"
            },
            ".card3": {
              "background-color": "@card3"
            },
            ".card4": {
              "background-color": "@card4"
            },
            ".card-title": {
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section class=\"features2\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"1\" max=\"4\" value=\"3\" step=\"1\">\n        <header>Colors</header>\n        <input type=\"color\" title=\"Card 1\" name=\"card1\" value=\"#f16f52\">\n        <input type=\"color\" title=\"Card 2\" name=\"card2\" value=\"#27b7eb\" condition=\"items > 1\">\n        <input type=\"color\" title=\"Card 3\" name=\"card3\" value=\"#6f5ad3\" condition=\"items > 2\">\n        <input type=\"color\" title=\"Card 4\" name=\"card4\" value=\"#59bb93\" condition=\"items > 3\">\n\n\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#c7cb05\">\n    </mbr-parameters>\n    <div class=\"images-container\" mbr-class=\"{'container-fluid':fullWidth, container:fullWidth==false}\">\n        <div class=\"row justify-content-center\">\n\n            <div class=\"col-lg-3 col-md-6 card card1\">\n\n                <h4 class=\"card-title align-center mbr-semibold mbr-black mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Projektowanie pod użytkownika</b></h4>\n                <p class=\"card-text align-center mbr-semibold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\" mbr-if=\"showText\">Na pierwszym miejscu potrzeby, preferencje i zachowania użytkowników końcowych. To podejście obejmuje szeroko zakrojone badania użytkowników, w tym ankiety, wywiady i testy użyteczności, aby zrozumieć grupę docelową.<br><br>\n                </p>\n\n\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-2-300x300.png\" alt>\n            </div>\n            <div class=\"col-lg-3 col-md-6 card card2\" mbr-if=\"items > 1\">\n                <h4 class=\"card-title align-center mbr-semibold mbr-black mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Content-first design</b></h4>\n                <p class=\"card-text align-center mbr-semibold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\" mbr-if=\"showText\">Czyli przede wszystkim treści jako główny czynnik napędzający proces projektowania. Poprzez priorytetowe traktowanie treści na wczesnym etapie fazy, daje to układ i strukturę skutecznie wspierającą i podkreślającą przekaz du użytkownika.&nbsp;<br><br><br>\n                </p>\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-300x249.png\" alt>\n            </div>\n            <div class=\"col-lg-3 col-md-6 card card3\" mbr-if=\"items > 2\">\n                <h4 class=\"card-title align-center mbr-semibold mbr-black mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Minimalistyczny design</b></h4>\n                <p class=\"card-text align-center mbr-semibold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\" mbr-if=\"showText\">Minimalistyczny styl kładzie nacisk na prostotę i przejrzystość, usuwając zbędne elementy, aby skupić się na istotnych funkcjach i treści. To podejście tworzy czyste, eleganckie witryny, po których łatwo się poruszać i które szybko się ładują.<br><br><br><br>\n                </p>\n                <img src=\"@PROJECT_PATH@/assets/images/mbr-300x150.png\" alt>\n            </div>\n            <div class=\"col-lg-3 col-md-6 card card4\" mbr-if=\"items > 3\">\n                <h4 class=\"card-title align-center mbr-semibold mbr-black mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\"><b>Consultancy Parthner</b></h4>\n                <p class=\"card-text align-center mbr-semibold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-text\" mbr-if=\"showText\">Lorem ipsum dolor sit amet, consectetur adipiscing\n                    elit. In posuere libero tortor, sit amet blandit mi ullamcorper ac. Praesent placerat condimentum\n                    sapien venenatis pretium vel rutrum.<br><br><br><br><br><br><br>\n                </p>\n                <img src=\"@PROJECT_PATH@/assets/images/4.png\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "clients03-r",
