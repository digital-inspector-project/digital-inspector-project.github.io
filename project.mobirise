        {
          "_name": "features02",
          "_sourceTheme": "investm5",
          "_styles": {
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image": {
              "&.disabled": {
                "display": "none"
              },
              "display": "block",
              "background-size": "cover",
              "background-position": "top center",
              "width": "100%",
              "height": "10%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".round": {
              "display": "none",
              "align-items": "center",
              "justify-content": "center",
              "width": "150px",
              "height": "150px",
              "background": "#ffbc00",
              "border-radius": "80%",
              "padding": "1rem",
              "margin": "auto",
              "margin-top": "3rem",
              "position": "relative",
              "z-index": "2",
              "@media (min-width: 1400px)": {
                "position": "absolute"
              }
            },
            ".arrow": {
              "font-size": "3rem",
              "color": "@arrow",
              "animation-duration": "1s",
              "animation-name": "slidein",
              "animation-iteration-count": "infinite",
              "display": "block"
            },
            ".arrow-col": {
              "display": "none",
              "overflow": "hidden",
              "margin-top": "5rem",
              "position": "relative",
              "z-index": "2"
            },
            ".row": {
              "align-items": "center"
            },
            ".text-wrapper": {
              "@media (min-width: 992px)": {
                "padding": "0 2rem"
              }
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#353535"
            },
            ".mbr-section-subtitle": {
              "text-align": "center",
              "color": "#ffffff"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-roundtext": {
              "text-align": "center"
            },
            "@media (max-width: 767px)": {
              "margin-top": "(@marginTop_mob * 1px)",
              "margin-bottom": "(@marginBottom_mob * 1px)",
              ".round": {
                "margin-top": "(@roundTop_mob * 1px)",
                "transform": "translateX(@roundTranslateX_mob * 1px)"
              },
              ".arrow-col": {
                "margin-top": "(@arrowTop_mob * 1px)",
                "transform": "translateX(@arrowTranslateX_mob * 1px)"
              },
              "& when (@showCircleMobile)": {
                ".round": {
                  "display": "flex"
                }
              },
              "& when (@showArrowMobile)": {
                ".arrow-col": {
                  "display": "block"
                }
              }
            },
            "@media (min-width: 768px) and (max-width: 1399px)": {
              "margin-top": "(@marginTop_tab * 1px)",
              "margin-bottom": "(@marginBottom_tab * 1px)",
              ".round": {
                "margin-top": "(@roundTop_tab * 1px)",
                "transform": "translateX(@roundTranslateX_tab * 1px) rotate(@roundRotate_tab * 1deg)"
              },
              ".arrow-col": {
                "margin-top": "(@arrowTop_tab * 1px)",
                "transform": "translateX(@arrowTranslateX_tab * 1px)"
              },
              "& when (@showCircleTablet)": {
                ".round": {
                  "display": "flex"
                }
              },
              "& when (@showArrowTablet)": {
                ".arrow-col": {
                  "display": "block"
                }
              }
            },
            "@media (min-width: 1400px)": {
              "margin-top": "(@marginTop_desk * 1px)",
              "margin-bottom": "(@marginBottom_desk * 1px)",
              ".round": {
                "top": "(@roundTop_desk * 1px)",
                "left": "(@roundLeft_desk * 1px)",
                "transform": "rotate(@roundRotate_desk * 1deg)"
              },
              ".arrow-col": {
                "margin-top": "(@arrowTop_desk * 1px)"
              },
              "& when (@showCircleDesktop)": {
                ".round": {
                  "display": "flex"
                }
              },
              "& when (@showArrowDesktop)": {
                ".arrow-col": {
                  "display": "block"
                }
              }
            },
            "@keyframes slidein": {
              "0%": {
                "transform": "translateY(-50px)"
              },
              "50%": {
                "transform": "translateY(0px)"
              },
              "100%": {
                "transform": "translateY(50px)"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2 d-md-none d-lg-block\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n&nbsp; \n'mbr-fullscreen': fullScreen,\n&nbsp; \t'mbr-parallax-background': bg.parallax}\">\n\n&nbsp; \t<mbr-parameters>\n&nbsp; \t\t<header>Size</header>\n&nbsp; \t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\n&nbsp; &nbsp; &nbsp; &nbsp; <header>Section Margin (Responsive)</header>\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Top (Mob)\" name=\"marginTop_mob\" min=\"-250\" max=\"250\" step=\"1\" value=\"0\">\n&nbsp; \t\t<input type=\"range\" inline title=\"Bot (Mob)\" name=\"marginBottom_mob\" min=\"-250\" max=\"250\" step=\"1\" value=\"-250\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Top (Tab)\" name=\"marginTop_tab\" min=\"-250\" max=\"250\" step=\"1\" value=\"-31\">\n&nbsp; \t\t<input type=\"range\" inline title=\"Bot (Tab)\" name=\"marginBottom_tab\" min=\"-250\" max=\"250\" step=\"1\" value=\"-250\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Top (Desk)\" name=\"marginTop_desk\" min=\"-250\" max=\"250\" step=\"1\" value=\"51\">\n&nbsp; \t\t<input type=\"range\" inline title=\"Bot (Desk)\" name=\"marginBottom_desk\" min=\"-250\" max=\"250\" step=\"1\" value=\"-250\">\n\n&nbsp; \t\t<header>Show/Hide</header>\n&nbsp; \t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showsubTitle\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n\n&nbsp; &nbsp; &nbsp; &nbsp; <header>Element Visibility</header>\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"checkbox\" title=\"Show Circle (Desktop)\" name=\"showCircleDesktop\" checked>\n&nbsp; \t\t<input type=\"checkbox\" title=\"Show Arrow (Desktop)\" name=\"showArrowDesktop\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"checkbox\" title=\"Show Circle (Tablet)\" name=\"showCircleTablet\" checked>\n&nbsp; \t\t<input type=\"checkbox\" title=\"Show Arrow (Tablet)\" name=\"showArrowTablet\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"checkbox\" title=\"Show Circle (Mobile)\" name=\"showCircleMobile\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Show Arrow (Mobile)\" name=\"showArrowMobile\">\n&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;\n&nbsp; &nbsp; &nbsp; &nbsp; <header>Mobile Positioning (max 767px)</header>\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Top (px)\" name=\"roundTop_mob\" min=\"-200\" max=\"300\" step=\"1\" value=\"48\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Left/Right (px)\" name=\"roundTranslateX_mob\" min=\"-300\" max=\"300\" step=\"1\" value=\"0\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Arrow Top (px)\" name=\"arrowTop_mob\" min=\"-200\" max=\"300\" step=\"1\" value=\"80\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Arrow Left/Right (px)\" name=\"arrowTranslateX_mob\" min=\"-300\" max=\"300\" step=\"1\" value=\"0\">\n\n&nbsp; &nbsp; &nbsp; &nbsp; <header>Tablet Positioning (768px - 1399px)</header>\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Top (px)\" name=\"roundTop_tab\" min=\"-200\" max=\"500\" step=\"1\" value=\"-101\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Left/Right (px)\" name=\"roundTranslateX_tab\" min=\"-500\" max=\"500\" step=\"1\" value=\"-412\">\n        <input type=\"range\" title=\"Circle Rotate (deg)\" name=\"roundRotate_tab\" min=\"-45\" max=\"45\" step=\"1\" value=\"-12\"> &nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Arrow Top (px)\" name=\"arrowTop_tab\" min=\"-200\" max=\"500\" step=\"1\" value=\"-59\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Arrow Left/Right (px)\" name=\"arrowTranslateX_tab\" min=\"-500\" max=\"500\" step=\"1\" value=\"0\">\n\n&nbsp; &nbsp; &nbsp; &nbsp; <header>Desktop Positioning (min 1400px)</header>\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Top (px)\" name=\"roundTop_desk\" min=\"-800\" max=\"800\" step=\"1\" value=\"-260\">\n&nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Circle Left (px)\" name=\"roundLeft_desk\" min=\"0\" max=\"1500\" step=\"1\" value=\"589\">\n        <input type=\"range\" title=\"Circle Rotate (deg)\" name=\"roundRotate_desk\" min=\"-45\" max=\"45\" step=\"1\" value=\"10\"> &nbsp; &nbsp; &nbsp; &nbsp; <input type=\"range\" inline title=\"Arrow Top (px)\" name=\"arrowTop_desk\" min=\"-200\" max=\"500\" step=\"1\" value=\"-42\">\n\n&nbsp; \t\t<header condition=\"showArrowDesktop || showArrowTablet || showArrowMobile\">Color</header>\n&nbsp; \t\t<input type=\"color\" title=\"Arrow\" name=\"arrow\" value=\"#ffcd40\" selected condition=\"showArrowDesktop || showArrowTablet || showArrowMobile\">\n&nbsp; \t\t\n&nbsp; \t\t<header>Background</header>\n&nbsp; \t\t<fieldset type=\"background\" name=\"bg\" parallax>\n&nbsp; \t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1065.jpg\" parallax>\n&nbsp; \t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n&nbsp; \t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n&nbsp; \t\t</fieldset>\n&nbsp; \t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n&nbsp; \t\t<input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/bg1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n&nbsp; \t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n&nbsp; \t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#20002e\" condition=\"overlay && bg.type !== 'color'\">\n&nbsp; \t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n&nbsp; \t</mbr-parameters>\n\n&nbsp; \t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n&nbsp; \t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n&nbsp; \t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n&nbsp; \t\t<div class=\"row justify-content-center\">\n&nbsp; \t\t\t<div class=\"col-12\">\n&nbsp; \t\t\t<h2 class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-1\" mbr-if=\"showsubTitle\">PO PROJEKTY <br>DRUGA STRON</h2>\n&nbsp; \t\t\t<h1 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">NANDME<br>NX9000<b><br></b></h1>\n&nbsp; \t\t\t</div>\n\n&nbsp; \t\t\t<div class=\"col-12 col-lg-6 col-md-12\">\n&nbsp; \t\t\t\t<div class=\"text-wrapper align-left\">\n&nbsp; \t\t\t\t\t\n&nbsp; \t\t\t\t\t<h3 class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">&nbsp; PEWNE SKOŃCZONE DZIEŁO,<br><br></h3>\n&nbsp; \t\t\t\t\t\n&nbsp; \t\t\t\t\t<div class=\"round\">&nbsp;\n&nbsp; \t\t\t\t\t<h3 class=\"mbr-roundtext mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-roundtext\">SZCZEGÓLNIE POLECANY PO&nbsp; PREMIUM</h3>\n&nbsp; \t\t\t\t\t\t</div>\n&nbsp; \t\t\t\t\t\n&nbsp; \t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get Started</a></div>\n&nbsp; \t\t\t\t</div>\n&nbsp; \t\t\t</div>\n&nbsp; \t\t\t\t<div class=\"col-12 arrow-col align-center\">&nbsp;\n&nbsp; \t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont arrow m-auto mobi-mbri-down mobi-mbri\"></span>\n&nbsp; \t\t\t\t\t</div>\n&nbsp; \t\t\t\n&nbsp; \t\t</div>\n&nbsp; \t</div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features02-3z",
          "_isUserblock": true,
