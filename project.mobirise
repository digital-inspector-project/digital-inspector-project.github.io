              "justify-content": "center"
            },
            ".content-wrapper": {
              ".line-wrapper": {
                "margin-bottom": "80px",
                "text-align": "center",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".line-wrap": {
                  "display": "inline-flex",
                  "width": "1px",
                  "height": "60px",
                  "background-color": "@line"
                }
              }
            },
            ".title-wrapper": {
              "@media (max-width: 992px)": {
