            },
            ".row": {
              "justify-content": "center"
            },
            ".content-wrapper": {
              ".line-wrapper": {
                "position": "relative",
                "top": "-10px",
                "margin-bottom": "8px",
                "text-align": "center",
                "@media (max-width: 992px)": {
