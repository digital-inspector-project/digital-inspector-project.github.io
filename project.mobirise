        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            "& when (@reverseContent)": {
              "@media (max-width: 991px)": {
                ".second": {
                  "margin-bottom": "2rem"
                }
              }
            },
            "& when (@customStyle)": {
              "input, textarea": {
                "border-left": "none",
                "border-top": "none",
                "border-right": "none",
                "border-radius": "4px",
                "padding": "20px 10px 20px 20px",
                "font-size": "13px",
                "color": "#130947",
                "font-weight": "600",
                "&:focus": {
                  "border-left": "none",
                  "border-top": "none",
                  "border-right": "none"
                }
              },
              ".form-control, .field-input": {
                "min-height": "3rem",
                "padding": "20px 10px 20px 20px",
                "background-color": "@fieldColor",
                "border-color": "@borderColor",
                "color": "@formText",
                "-webkit-transition": "0.4s",
                "transition": "0.4s",
                "box-shadow": "none",
                "outline": "none",
                "&:hover, &:focus": {
                  "background-color": "@fieldHover",
                  "border-color": "@borderHover !important",
                  "color": "contrast(@fieldColor)",
                  "box-shadow": "none",
                  "outline": "none"
                }
              },
              "input::-webkit-input-placeholder, textarea::-webkit-input-placeholder": {
                "color": "@formPlaceholder"
              },
              "input:-moz-placeholder, textarea:-moz-placeholder": {
                "color": "@formPlaceholder"
              },
              ".jq-selectbox li, .jq-selectbox li": {
                "background-color": "@fieldColor",
                "color": "contrast(@fieldColor, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox li:hover, .jq-selectbox li.selected": {
                "background-color": "@fieldHover",
                "color": "contrast(@fieldHover, #000000, #ffffff, 30%)"
              },
              ".jq-selectbox:hover .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldColor"
              },
              ".jq-selectbox .jq-selectbox__trigger-arrow": {
                "border-top-color": "@fieldHover"
              }
            },
            ".mbr-subtitle": {
              "color": "#4f87fb",
              "font-weight": "800"
            },
            ".mbr-subtitle.display-4": {
              "font-size": "13px",
              "line-height": "1.85",
              "letter-spacing": "2px"
            },
            ".mbr-section-title": {
              "color": "#130947",
              "font-weight": "700"
            },
            ".mbr-text": {
              "line-height": "2",
              "letter-spacing": "0",
              "margin-top": "20px",
              "color": "#6d7a8c"
            },
            ".mbr-section-title.display-2": {
              "line-height": "1.2",
              "letter-spacing": "-0.5px"
            },
            "img": {
              "width": "100%",
              "height": "100%",
              "-o-object-fit": "cover",
              "object-fit": "cover"
            },
            ".mbr-form": {
              "max-width": "550px",
              "span.value.form-control": {
                "min-height": "3.5rem",
                "padding": "1rem"
              }
            },
            "textarea": {
              "min-height": "150px"
            },
            ".mbr-form .btn": {
              "-webkit-box-pack": "center",
              "justify-content": "center",
              "border-width": "2px",
              "border-radius": "30px",
              "border-color": "@primaryColor",
              "color": "#4f87fb",
              "padding": "18px 29px",
              "&:hover": {
                "color": "#ffffff"
              }
            },
            ".second": {
              "height": "fit-content",
              ".inbox": {
                "position": "static",
                "bottom": "-70px",
                "width": "100%",
                ".inbox-box": {
                  "padding": "36px 20px 36px",
                  "background-color": "@primaryColor",
                  ".info-widget": {
                    "padding-top": "0.5rem",
                    "display": "flex",
                    "-webkit-box-orient": "horizontal",
                    "-webkit-box-direction": "normal",
                    "flex-direction": "row",
                    "-webkit-box-pack": "start",
                    "justify-content": "flex-start",
                    "-webkit-box-align": "center",
                    "align-items": "center",
                    ".widget-icon": {
                      "display": "inline-block",
