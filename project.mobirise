        {
          "_name": "slider02",
          "_sourceTheme": "immersem5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 30px",
                "@media (max-width: 768px)": {
                  "padding": "0 20px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 20px"
              }
            },
            ".content-wrapper": {
              "padding": "60px 60px 40px",
              "background-color": "@container",
              "border-radius": "20px",
              "@media (max-width: 992px)": {
                "padding": "60px 20px 40px"
              },
              ".content-wrap": {
                "padding": "0 86px",
                "@media (max-width: 768px)": {
                  "padding": "0"
                },
                ".mbr-desc": {
                  "margin-bottom": "60px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".mbr-section-title": {
                  "margin-bottom": "40px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-flex",
                    "width": "40%",
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "width": "100%",
                      "margin-bottom": "20px"
                    }
                  }
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "672px",
              "max-width": "672px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "border-radius": "20px !important",
                "background-color": "@card",
                "overflow": "hidden",
                ".item-wrapper": {
                  ".item-img": {
                    "img": {
                      "height": "340px",
                      "border-radius": "0 !important",
                      "object-fit": "cover",
                      "@media (max-width: 768px)": {
                        "height": "300px"
                      }
                    }
                  },
                  ".item-content": {
                    "padding": "32px",
                    "z-index": "1",
                    "position": "relative",
                    "@media (max-width: 768px)": {
                      "padding": "32px 20px"
                    },
                    ".item-desc": {
                      "margin-bottom": "32px",
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      "@media (max-width: 768px)": {
                        "display": "block",
                        "margin-bottom": "20px"
                      },
                      ".icon-wrapper": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".mbr-iconfont": {
                          "font-size": "54px",
                          "color": "@icon",
                          "margin-right": "32px",
                          "@media (max-width: 768px)": {
                            "margin-right": "0"
                          }
                        }
                      },
                      ".list": {
                        "display": "inline-flex",
                        "justify-content": "flex-end",
                        "flex-wrap": "wrap",
                        "margin": "0",
                        "padding": "0",
                        "list-style-type": "none",
                        "@media (max-width: 768px)": {
                          "justify-content": "flex-start"
                        },
                        ".item-wrap": {
                          "display": "inline-flex",
                          "align-items": "center",
                          "justify-content": "center",
                          "background-color": "@tagsBg",
                          "border-radius": "30px",
                          "margin-right": "10px",
                          "margin-bottom": "5px",
                          "padding": "12px 16px",
                          "&:last-child": {
                            "margin-right": "0"
                          }
                        }
                      }
                    },
                    ".name-wrapper": {
                      "display": "flex",
                      "justify-content": "space-between",
                      "align-items": "flex-end",
                      "@media (max-width: 768px)": {
                        "display": "block"
                      },
                      ".name-wrap": {
                        "@media (max-width: 768px)": {
                          "margin-bottom": "20px"
                        },
                        ".item-name": {
                          "margin-bottom": "8px"
                        },
                        ".item-role": {
                          "margin-bottom": "0"
                        }
                      },
                      ".social-wrapper": {
                        "display": "flex",
                        ".soc-item": {
                          "a": {
                            "display": "block",
                            "&:hover, &:hover": {
                              ".mbr-iconfont": {
                                "border": "1px solid @socColor"
                              }
                            },
                            ".mbr-iconfont": {
                              "display": "flex",
                              "align-items": "center",
                              "justify-content": "center",
                              "width": "54px",
                              "height": "54px",
                              "border-radius": "100%",
                              "border": "1px solid @socBorder",
                              "color": "@socColor",
                              "font-size": "18px",
                              "transition": "all 0.3s ease-in-out",
                              "margin-right": "10px"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "top": "-24px",
              "width": "48px",
              "height": "48px",
              "margin-top": "-1.5rem",
              "font-size": "18px",
              "background-color": "transparent !important",
              "color": "@infoColor !important",
              "border": "2px solid @infoColor !important",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": ".6 !important",
              "@media (max-width: 768px)": {
                "top": "2.5rem"
              },
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&:hover": {
                "opacity": "1 !important"
              },
              "&.embla__button--prev": {
                "left": "30px"
              },
              "&.embla__button--next": {
                "right": "30px"
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "& when (@arrows)": {
                "padding-top": "60px",
                "@media (max-width: 768px)": {
                  "padding-top": "100px"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "visible",
              "width": "100%",
              "margin-right": "1rem",
              "@media (max-width: 767px)": {
                "overflow": "hidden"
              }
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".item-name": {
              "color": "#000000",
              "text-align": "left"
            },
            ".item-role": {
              "color": "#000000"
            },
            ".list": {
              "color": "#000000"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            }
          },
          "_customHTML": "<section class=\"slider02 mbr-embla\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showDesc\" title=\"Description\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\" checked>\n        <input type=\"color\" name=\"container\" title=\"Container BG\" value=\"#440560\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"4\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" name=\"showIcon\" title=\"Icon\" checked>\n        <input type=\"color\" name=\"icon\" title=\"Icon Color\" value=\"#999c9f\" condition=\"showIcon\">\n        <input type=\"checkbox\" name=\"showTags\" title=\"Tags\" checked>\n        <input type=\"color\" name=\"tagsBg\" title=\"Tags BG\" value=\"#ffffff\" condition=\"showTags\">\n        <input type=\"checkbox\" name=\"showName\" title=\"Name\" checked>\n        <input type=\"checkbox\" name=\"showRole\" title=\"Role\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <input type=\"range\" inline title=\"Social Amount\" name=\"soc\" min=\"1\" max=\"2\" step=\"1\" value=\"2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social Color\" value=\"#000000\" name=\"socColor\" condition=\"showSocial\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#dcdde0\" name=\"socBorder\" condition=\"showSocial\" selected>\n        <input type=\"color\" name=\"card\" title=\"Card BG\" value=\"#f2f2f4\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-14.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"content-wrap\" mbr-if=\"showTitle || showDesc || showButtons\">\n                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                            HELLO WORLD - TO COŚ WIĘCEJ, NIŻ TYLKO HASŁO</p>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .mbr-section-btn\"><b>PRZEGLĄDAJ ARTYKUŁY I</b><br><b>SPRAWDZONE PORADY.</b></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                Poznaj świat praktycznych porad i eksperckich artykułów, które dostarczą Ci wiedzy i inspiracji do działania. Zanurz się w tematyce SEO, marketingu i technologii, by rozwijać swoje umiejętności, wdrażać skuteczne strategie i odkrywać nowe możliwości. Wspólnie tworzymy przestrzeń rozwoju i sukcesu.\n                            </p>\n                        </div>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-white\" href=\"index.html#poradniki-digital-inspector\" data-app-placeholder=\"Type Text\">WIĘCEJ</a>\n                            <a class=\"btn btn-primary\" href=\"https://digital-inspector.blogspot.com/\" data-app-placeholder=\"Type Text\" target=\"_blank\">START</a></div>\n                    </div>\n                    <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                        <div class=\"embla__viewport\">\n                            <div class=\"embla__container\">\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                \n                                            <a href=\"https://digital-inspector.blogspot.com/2025/05/znaczenie-audytu-seo-w-e-commerce-klucz.html\" target=\"true\"><img src=\"@PROJECT_PATH@/assets/images/seo-audyt-upscayl-4x-remacri.webp\" alt=\"znaczenie-audytu-seo-w-e-commerce-klucz\"></a></div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-align-justify mobi-mbri\"></span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><b>Znaczenie audytu SEO</b><b>: klucz do&nbsp;</b><b>SERP i lepszej&nbsp;</b><br><b>widoczności sklepu internetowego.</b></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">W dynamicznie rozwijającym się świecie handlu online&nbsp;<strong>audyt SEO dla sklepów e-commerce</strong> nie jest już dodatkiem — to absolutna podstawa skutecznej obecności...</p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont socicon-facebook mobi-mbri-android mobi-mbri\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/odwie-star-stron-upscayl-4x-remacri.webp\" alt=\"odśwież_starą_stronę\">\n                                            </div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-align-justify mobi-mbri\"></span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><b>Modernizacja starej strony internetowej czyli jak przyciągnąć użytkowników i zwiększyć widoczność </b><br><b>w 2025 roku?</b></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">Modernizacja strony sklepu internetowego to znacznie więcejniż tylko zmiana szaty graficznej. To&nbsp;<strong>kompleksowy proces transformacji</strong>, który...</p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-facebook\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/pracujemy-nad-seo-planem-artyku-upscayl-4x-realesrgan-x4plus.webp\" alt=\"pracujemy_nad_seo_planem\">\n                                            </div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-align-justify mobi-mbri\"></span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><b>Co to jest strategia SEO i jak ją skutecznie wdrożyć ?</b></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">W dzisiejszym cyfrowym świecie, gdzie każda sekunda spędzona online może\n<br>  zadecydować o sukcesie lub porażce firmy, <strong>strategia SEO</strong> staje się kluczow...</p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-facebook\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                                <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                    <div class=\"slide-content\">\n                                        <div class=\"item-wrapper\">\n                                            <div class=\"item-img\">\n                                                <img src=\"@PROJECT_PATH@/assets/images/senuto-jaka-realna-przewaga-upscayl-4x-remacri.webp\" alt=\"senuto_jako_realna_przewaga\">\n                                            </div>\n                                            <div class=\"item-content\">\n                                                <div class=\"item-desc\" mbr-if=\"showIcon || showTags\">\n                                                    <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-align-justify mobi-mbri\"></span>\n                                                    </div>\n                                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" mbr-if=\"showTags\" data-multiline mbr-article>\n                                                        <li class=\"item-wrap\">Science</li>\n                                                        <li class=\"item-wrap\">Knowledge</li>\n                                                    </ul>\n                                                </div>\n                                                <div class=\"name-wrapper\">\n                                                    <div class=\"name-wrap\">\n                                                        <h4 class=\"item-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-name\" mbr-if=\"showName\"><b>Senuto czyli kompleksowe narzędzie SEO&nbsp;</b></h4>\n                                                        <p class=\"item-role mbr-fonts-style\" mbr-if=\"showRole\" mbr-theme-style=\"display-4\" data-app-selector=\".item-role\">W dynamicznym świecie marketingu cyfrowego, gdzie zmiany następują z dnia na\n<br>  dzień,&nbsp;<strong <br=\"\">przewaga nad konkurencją zależy od odpowiedniego wsparcia technologicznego</strong>. Właśnie tutaj pojaw...</p>\n                                                    </div>\n                                                    <div class=\"social-wrapper\" mbr-if=\"showSocial\">\n                                                        <div class=\"soc-item\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-facebook\"></span>\n                                                            </a>\n                                                        </div>\n                                                        <div class=\"soc-item\" mbr-if=\"soc > 1\">\n                                                            <a href=\"https://mobiri.se/\">\n                                                                    <span mbr-icon class=\"mbr-iconfont\n                                                                     socicon socicon-youtube\"></span>\n                                                            </a>\n                                                        </div>\n                                                    </div>\n                                                </div>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
