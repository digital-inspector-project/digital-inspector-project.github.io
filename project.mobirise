        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".text": {
              "letter-spacing": "0.03em",
              "line-height": "1.7"
            },
            ".mbr-text": {
              "width": "100%",
              "height": "auto",
              "text-align": "center"
            },
            ".content": {
              "flex-basis": "auto !important",
              "-webkit-flex-basis": "auto !important"
            },
            "@media (max-width: 991px)": {
              ".row": {
                "display": "flex",
                "-webkit-flex-direction": "column",
                "flex-direction": "column",
                "-webkit-align-items": "center",
                "align-items": "center"
              },
              ".content": {
                "-webkit-flex": "0 0 100%",
                "flex": "0 0 100%",
                "max-width": "100%",
                "margin-left": "0"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "text-align": "center"
            }
          },
          "_name": "header4",
          "_sourceTheme": "portfoliom4",
          "_customHTML": "<section class=\"header4\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    \n    <mbr-parameters>\n    \n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Show Arrow\" name=\"showArrow\" condition=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\"> \n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>       \n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1440x958.jpg\" selected>\n            <input type=\"color\" title=\"Background Color\" value=\"#232323\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=l8UXhtqV6hU\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2-3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"rgb(7,9,21)\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"overlay && bg.type !== 'color'\">\n   \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div> \n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\" col-md-10 content\">\n                <h1 class=\"mbr-section-title mbr-light pb-3 mbr-white mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><br>Dział Dokumenty&nbsp;<br></h1>\n                <p class=\"mbr-text mbr-fonts-style mbr-white\" mbr-theme-style=\"display-2\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Regulamin sklepu internetowego</p>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-arrow-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "header4-1z",
          "_isUserblock": true,
          "_cid": "uZygjSARtr",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_customTemplate": true,
          "_afterNavbarItem": false,
          "_customHTML": "\n    <section style=\"margin-bottom: 2em; text-align: center;\">\n<small>\n\tNiniejszy regulamin jest chronionym dziełem intelektualnym i nie może być kopiowany, powielany ani udostępniany w całości lub części bez zgody właściciela sklepu.\n</small>\n</section>\n<div>\n<h1 document-name=\"regulations\" class=\"document-heading center\">Regulamin świadczenia usług jako <br><br>Digital Inspector</h1>\n<br><br>\n<p class=\"center\">\n    Niniejszy dokument określa zasady zawierania umów w Sklepie, zawiera kluczowe informacje o Sprzedawcy, <br>Sklepie oraz o prawach Konsumentów i Kupujących uprzywilejowanych w oparciu o polskie i unijne przepisy prawne, w tym RODO.\n</p>\n\n</div>\n\n<p>\n    <strong>SPIS TREŚCI</strong><br>\n    <strong>§ 1</strong> Definicje<br>\n    <strong>§ 2</strong> Kontakt ze Sprzedawcą<br>\n    <strong>§ 3</strong> Wymogi techniczne<br>\n    <strong>§ 4</strong> Zakupy w Sklepie<br>\n    <strong>§ 5</strong> Płatności<br>\n    <strong>§ 6</strong> Realizacja zamówienia<br>\n    <strong>§ 7</strong> Prawo odstąpienia od umowy<br>\n    <strong>§ 8</strong> Wyjątki od prawa odstąpienia od umowy<br>\n    <strong>§ 9</strong> Reklamacje<br>\n    <strong>§ 10</strong> Dane osobowe<br>\n    <strong>§ 11</strong> Zastrzeżenia<br>\n    <strong>Załącznik nr 1:</strong> Wzór formularza odstąpienia od umowy\n</p>\n\n<h2>§ 1 DEFINICJE</h2>\n\n<p>\n<strong>Dni robocze</strong> – dni od poniedziałku do piątku, wyłączając dni ustawowo wolne od pracy w Polsce.<br>\n<strong>Konsument</strong> – osoba fizyczna dokonująca zakupu w Sklepie w celach niezwiązanych z działalnością gospodarczą lub zawodową (art. 22(1) Kodeksu cywilnego).<br>\n<strong>Kupujący</strong> – każdy podmiot dokonujący zakupu w Sklepie.<br>\n<strong>Kupujący uprzywilejowany</strong> – Konsument lub osoba fizyczna prowadząca działalność gospodarczą, korzystająca z ochrony przewidzianej dla Konsumentów (art. 38a Ustawy o prawach konsumenta).<br>\n<strong>Regulamin</strong> – niniejszy dokument, określający zasady zawierania umów w Sklepie.<br>\n<strong>Sklep</strong> – sklep internetowy Digital Inspector prowadzony pod adresem <a href=\"https://digitalinspector-start.github.io/\" target=\"_blank\">https://digitalinspector-start.github.io/</a>.<br>\n<strong>Sprzedawca</strong> – Digital Inspector, Ulica, 03-252 Warszawa, email: <a href=\"mailto:digitalinspector@engineer.com\">digitalinspector@engineer.com</a>.<br>\n<strong>Treści cyfrowe</strong> – dane wytwarzane i dostarczane w formie cyfrowej.<br>\n<strong>Ustawa o prawach konsumenta</strong> – polska ustawa z dnia 30 maja 2014 r. o prawach konsumenta.<br>\n<strong>RODO</strong> – Rozporządzenie Parlamentu Europejskiego i Rady (UE) 2016/679 z dnia 27 kwietnia 2016 r. w sprawie ochrony osób fizycznych w związku z przetwarzaniem danych osobowych.\n</p>\n\n<h2>§ 2 KONTAKT ZE SPRZEDAWCĄ</h2>\n\n<ol>\n    <li>Adres pocztowy: Ulica 32, 03-252 Warszawa</li>\n    <li>Adres e-mail: <a href=\"mailto:digitalinspector@engineer.com\">digitalinspector@engineer.com</a></li>\n    <li>Telefon: 739052882</li>\n    <li>\n        Koszty połączeń telefonicznych oraz transmisji danych wynikają z taryfy operatora Kupującego. Połączenia międzynarodowe mogą generować wyższe koszty zgodnie z cennikiem dostawcy usług telekomunikacyjnych.\n    </li>\n</ol>\n\n<h2>§ 3 WYMOGI TECHNICZNE</h2>\n\n<ol>\n    <li>\n        Do korzystania z funkcjonalności Sklepu wymagane są:\n        <ul>\n            <li>Urządzenie z dostępem do Internetu.</li>\n            <li>Przeglądarka obsługująca JavaScript i cookies.</li>\n        </ul>\n    </li>\n    <li>Do złożenia zamówienia wymagane jest posiadanie aktywnego adresu e-mail.</li>\n</ol>\n\n<h2>§ 4 ZAKUPY W SKLEPIE</h2>\n\n<ol>\n    <li>Produkty dostępne w Sklepie prezentowane są wraz z całkowitą ceną brutto.</li>\n    <li>Kupujący dodaje wybrany produkt do koszyka, wybiera metodę płatności oraz podaje dane niezbędne do realizacji zamówienia.</li>\n    <li>Zamówienie zostaje złożone w momencie potwierdzenia jego treści i akceptacji Regulaminu przez Kupującego.</li>\n    <li>Złożenie zamówienia jest równoznaczne z zawarciem umowy między Kupującym a Sprzedawcą zgodnie z Ustawą o prawach konsumenta.</li>\n</ol>\n\n<h2>§ 5 PŁATNOŚCI</h2>\n\n<ol>\n    <li>Sklep oferuje następujące metody płatności:\n        <ul>\n            <li>Przelew bankowy.</li>\n        </ul>\n    </li>\n    <li>W przypadku płatności z góry Kupujący powinien dokonać wpłaty w ciągu 7 dni roboczych od złożenia zamówienia.</li>\n    <li>Kupujący akceptuje wystawianie faktur elektronicznych, które mogą być wycofane w dowolnym momencie poprzez kontakt ze Sprzedawcą.</li>\n</ol>\n\n<h2>§ 6 REALIZACJA ZAMÓWIENIA</h2>\n\n<ol>\n    <li>Realizacja zamówienia następuje w terminie 14 dni roboczych od zaksięgowania wpłaty (przy płatności z góry).</li>\n    <li>Produkty są dostarczane w formie elektronicznej na adres e-mail podany przez Kupującego.</li>\n</ol>\n\n<h2>§ 7 PRAWO ODSTĄPIENIA OD UMOWY</h2>\n\n<ol>\n    <li>Kupujący uprzywilejowany ma prawo odstąpić od umowy w terminie 14 dni od jej zawarcia, bez podawania przyczyny, zgodnie z art. 27 Ustawy o prawach konsumenta.</li>\n    <li>Odstąpienie od umowy można zgłosić, korzystając z danych kontaktowych podanych w § 2 Regulaminu.</li>\n    <li>Formularz odstąpienia znajduje się w Załączniku nr 1 do Regulaminu.</li>\n</ol>\n\n<h2>§ 8 WYJĄTKI OD PRAWA ODSTĄPIENIA OD UMOWY</h2>\n\n<ol>\n    <li>Prawo odstąpienia od umowy nie przysługuje w przypadku świadczenia Treści cyfrowych, które są dostarczane za zgodą Kupującego przed upływem terminu odstąpienia, zgodnie z art. 38 pkt 13 Ustawy o prawach konsumenta.</li>\n</ol>\n\n<h2>§ 9 REKLAMACJE</h2>\n\n<ol>\n    <li>Sprzedawca ponosi odpowiedzialność za zgodność produktów z umową na podstawie Ustawy o prawach konsumenta oraz art. 43a i nast. tej ustawy.</li>\n    <li>Reklamacje należy zgłaszać pisemnie na adres Sprzedawcy lub mailowo na digitalinspector@engineer.com.</li>\n</ol>\n\n<h2>§ 10 DANE OSOBOWE</h2>\n\n<ol>\n    <li>Administratorem danych osobowych jest Sprzedawca. Szczegółowe informacje dotyczące przetwarzania danych znajdują się w polityce prywatności.\n</li></ol>\n<br><br>\n\n<p style=\"text-align: center;\">\n    <strong>WZÓR FORMULARZA ODSTĄPIENIA OD UMOWY</strong><br>\n    (formularz ten należy wypełnić i odesłać tylko w przypadku chęci odstąpienia od umowy)\n</p>\n\n<p>\n    Digital Inspector\nemail :  digitalinspector@engineer.com    <br>\n    Adres xxx 03-252 Warszawa    <br>\n    adres e-mail: digitalinspector@engineer.com<br>\n</p>\n\n<p>\n    - Ja/My(*) ..................................................................... niniejszym informuję/informujemy(*)\n    o moim/naszym odstąpieniu od umowy sprzedaży następujących towarów(*) /  o świadczenie następującej usługi(*)    / o dostarczenie treści cyfrowych w postaci(*):\n    <br><br>\n    ..............................................................................................................................................................................<br><br>\n    ..............................................................................................................................................................................<br><br>\n    ..............................................................................................................................................................................<br>\n</p>\n<p>\n    - Data zawarcia umowy<sup>(*)</sup>/odbioru<sup>(*)</sup><br><br>\n    ..............................................................................................................................................................................<br><br>\n\n    - Imię i nazwisko Konsumenta(-ów) / Przedsiębiorcy(-ów) uprzywilejowanego(-ych):<br><br>\n    ..............................................................................................................................................................................<br><br>\n\n    - Adres Konsumenta(-ów) / Przedsiębiorcy(-ów) uprzywilejowanego(-ych):<br><br>\n    ..............................................................................................................................................................................<br><br>\n    ..............................................................................................................................................................................<br><br>\n</p>\n<p style=\"text-align: right\">\n    \n    .............................................................................................<br>\n    Podpis Konsumenta(-ów) / Przedsiębiorcy(-ów) uprzywilejowanego(-ych) <br>\n    <small>(tylko jeżeli formularz jest przesyłany w wersji papierowej)</small>\n    <br><br>\n\n    Data ............................................\n</p>\n<p style=\"text-align: right\">\n    <small>(*) Niepotrzebne skreślić.</small>\n</p>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 80px 0;\n  color: black;\n  text-align: center;\n}\np {\n  font-size: 20px;\n  color: black;\n}",
