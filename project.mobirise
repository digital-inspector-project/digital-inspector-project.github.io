                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "100%",
                    "background-color": "rgba(0, 0, 0, 0.4)",
                    "border-radius": "20px",
                    "pointer-events": "none"
                  },
                  ".item-content": {
                    "width": "100%",
                    "position": "relative",
                    "z-index": "1",
                    ".card-title": {
