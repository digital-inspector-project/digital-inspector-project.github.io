                        "width": "48px",
                        "height": "48px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "font-size": "18px",
                        "color": "@icon",
                        "background-color": "@iconBg",
                        "border-radius": "100%",
                        "transition": "all 0.3s ease-in-out"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-btn": {
              "margin-top": "40px"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-desc": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#ffffff"
            },
            ".card-name": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-role": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "center"
            },
            ".card-title, .icon-wrapper": {
              "text-align": "center",
              "color": "#ffffff"
            }
          },
          "_customHTML": "<section class=\"features03 immersem5\" group=\"Features\" mbr-class=\"{\n     'mbr-fullscreen': fullScreen,\n     'mbr-parallax-background': bg.parallax}\">\n     <mbr-parameters>\n         <header>Size</header>\n         <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n         <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n         <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n         <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n         <header>Show/Hide</header>\n         <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n         <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n         <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n         <input type=\"color\" title=\"Container BG\" value=\"#efefef\" name=\"container\" selected>\n         <header>Cards</header>\n         <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n         <input type=\"checkbox\" title=\"Name\" name=\"showName\" checked>\n         <input type=\"checkbox\" title=\"Role\" name=\"showRole\" checked>\n         <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n         <input type=\"color\" title=\"Icon Color\" value=\"#232323\" name=\"icon\" condition=\"showIcon\" selected>\n         <input type=\"color\" title=\"Icon BG\" value=\"#20002e\" name=\"iconBg\" condition=\"showIcon\" selected>\n         <input type=\"color\" title=\"Card Border\" value=\"#efefef\" name=\"border\" selected>\n         <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\">\n         <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\">\n         <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\">\n         <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked>\n         <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#977aa4\" condition=\"overlay\">\n         <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay\">\n         <header>Background</header>\n         <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n         <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n\t\n    \n    \n         <header condition=\"bg.type === 'video'\">Fallback Image</header>\n         <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-14.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n         <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n         <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n         <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n     </mbr-parameters>\n\n     <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n     <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n     <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n         <div class=\"row\">\n             <div class=\"col-12 item\">\n                 <div class=\"content-wrapper\">\n                     <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showDesc\" data-app-selector=\".mbr-desc\">\n                         Scientists\n                     </p>\n                     <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                         <b>Pride of our community</b>\n                     </h2>\n                 </div>\n             </div>\n             <div class=\"item features-image col-12 col-lg-3\">\n                 <div class=\"item-wrapper\">\n                     <div class=\"item-img\">\n                         <img src=\"@PROJECT_PATH@/assets/images/mbr-455x690.png\" alt=\"restauracje\">\n                         <div class=\"image-overlay\"></div>\n                         <div class=\"item-content\">\n                             <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Bistro</h4>\n                             <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-name\" mbr-if=\"showName\">\n                                 <b>Restauracje</b></p>\n                             <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-role\" mbr-if=\"showRole\">Miejsce na spotkania, pyszne jedzenie i relaks.</p>\n                             <a href=\"#\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                 <span mbr-icon class=\"mbr-iconfont li_food\" style=\"color: rgb(205, 138, 209); fill: rgb(205, 138, 209);\"></span>\n                             </a>\n                         </div>\n                     </div>\n                 </div>\n             </div>\n             <div class=\"item features-image col-12 col-lg-3\">\n                 <div class=\"item-wrapper\">\n                     <div class=\"item-img\">\n                         <img src=\"@PROJECT_PATH@/assets/images/mbr-2-455x684.jpeg\" alt=\"elektrycy\">\n                         <div class=\"image-overlay\"></div>\n                         <div class=\"item-content\">\n                             <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">&nbsp;Firmy budowlane</h4>\n                             <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-name\" mbr-if=\"showName\"><b>Elektrycy</b></p>\n                             <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-role\" mbr-if=\"showRole\">\n                                 Naprawa awarii i nowe instalacje. Bezpieczeństwo.</p>\n                             <a href=\"#\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                 <span mbr-icon class=\"mbr-iconfont imind-electricity\" style=\"color: rgb(205, 138, 209); fill: rgb(205, 138, 209);\"></span>\n                             </a>\n                         </div>\n                     </div>\n                 </div>\n             </div>\n             <div class=\"item features-image col-12 col-lg-3\">\n                 <div class=\"item-wrapper\">\n                     <div class=\"item-img\">\n                         <img src=\"@PROJECT_PATH@/assets/images/image1-455x683.jpg\" alt=\"influencerka\" data-slide-to=\"3\" data-bs-slide-to=\"4\">\n                         <div class=\"image-overlay\"></div>\n                         <div class=\"item-content\">\n                             <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Social-Media</h4>\n                             <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-name\" mbr-if=\"showName\"><b>Influencer</b></p>\n                             <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-role\" mbr-if=\"showRole\">Budowanie społeczności online i tworzenie materiałów filmowych.</p>\n                             <a href=\"#jjjjjjjjjjjjjjjjjjjjjjjjjjjjj\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                 <span mbr-icon class=\"mbr-iconfont mbri-camera\" style=\"color: rgb(205, 138, 209); fill: rgb(205, 138, 209);\"></span>\n                             </a>\n                         </div>\n                     </div>\n                 </div>\n             </div>\n             <div class=\"item features-image col-12 col-lg-3\">\n                 <div class=\"item-wrapper\">\n                     <div class=\"item-img\">\n                         <img src=\"@PROJECT_PATH@/assets/images/mbr-455x683.jpg\" alt=\"Prawnik\" data-slide-to=\"3\" data-bs-slide-to=\"4\">\n                         <div class=\"image-overlay\"></div>\n                         <div class=\"item-content\">\n                             <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Zawody Prawnicze</h4>\n                             <p class=\"card-name mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-name\" mbr-if=\"showName\">\n                                 <b>Prawnik</b></p>\n                             <p class=\"card-role mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".card-role\" mbr-if=\"showRole\">Rozwiązywanie problemów prawnych i ochrona praw.</p>\n                             <a href=\"#\" class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                 <span mbr-icon class=\"mbr-iconfont fa-legal fa\" style=\"color: rgb(205, 138, 209); fill: rgb(205, 138, 209);\"></span>\n                             </a>\n                         </div>\n                     </div>\n                 </div>\n             </div>\n             <div class=\"col-12 item\">\n                 <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                     <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                         Contacts\n                     </a>\n                 </div>\n             </div>\n         </div>\n     </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features03-dt",
          "_isUserblock": true,
          "_cid": "v2qDaXabMf",
