                    ".widget-content": {
                      "display": "inline-block",
                      "vertical-align": "baseline",
                      "text-align": "left",
                      "color": "#ffffff",
                      ".widget-title": {
                        "margin-bottom": "7px",
                        "letter-spacing": "2px",
                        "font-weight": "700"
                      },
                      ".widget-title.display-7": {
                        "font-size": "15px",
                        "line-height": "1.2",
                        "letter-spacing": "2px"
                      },
                      ".widget-text": {
                        "margin-bottom": "0",
                        "font-weight": "700"
                      },
                      ".widget-text.display-5": {
                        "line-height": "1.2",
                        "letter-spacing": "-0.5px"
                      }
                    }
                  }
                }
              }
            },
            "@media (max-width: 768px)": {
              ".mbr-section-title": {
                "text-align": "left"
              },
              ".second": {
                "margin-top": "30px"
              },
              ".mbr-section-btn": {
                "text-align": "center"
              }
            },
            ".widget-text": {
              "text-align": "left",
              "color": "#ffffff"
            },
            ".widget-title, .widget-icon": {
              "text-align": "left",
              "color": "#000000"
            },
            "H3": {
              "color": "#444444",
              "text-align": "left"
            },
            "LABEL": {
              "color": "#000000"
            },
            "H2": {
              "color": "#03426a",
              "text-align": "left"
            }
          },
          "_name": "form1",
          "_sourceTheme": "medicalm4",
          "_customHTML": "<section class=\"form1 medicalm4_form1\" group=\"Forms\" plugins=\"formstyler, datepicker\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showText\">\n\t\t<input type=\"checkbox\" title=\"Reverse Content\" name=\"reverseContent\" checked>\n\n\t\t<header>Style</header>\n\t\t<input type=\"checkbox\" name=\"customStyle\" title=\"Custom Style\">\n\t\t<input type=\"color\" name=\"fieldColor\" title=\"Field\" value=\"#ffffff\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"fieldHover\" title=\"Field Hover\" value=\"#ffffff\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"borderColor\" title=\"Border\" value=\"#ffffff\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"borderHover\" title=\"Border Hover\" value=\"#ffffff\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"formText\" title=\"Text\" value=\"#000000\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"formPlaceholder\" title=\"Placeholders\" value=\"#6d7a8c\" condition=\"customStyle\">\n\t\t<input type=\"color\" name=\"widgetIconBg\" title=\"Widget Icon Bg\" value=\"#faff00\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n        \n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n\t<input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"(overlay&&bg.type=='image')\"></div>\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div mbr-form class=\"col-lg-6 mx-auto mbr-form\" mbr-class=\"{'order-2': reverseContent}\">\n<form action=\"xampiotris@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"form-row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Dziękujemy za wypełnienie zgłoszenia !</div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">Oops...! some problem!</div>\n</div>\n<div class=\"dragArea form-row\">\n<div class=\"col-lg-12\">\n<h3 mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" class=\"mbr-subtitle mbr-fonts-style mbr-bold\">ZAREZERWUJ SPOTKANIE</h3>\n</div>\n<div class=\"col-lg-12\">\n<h2 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title align-left pb-4 mbr-bold mbr-fonts-style\">Wypełnij formularz <br>SPOTKAJMY SIĘ ONLINE</h2>\n</div>\n<div class=\"col-lg-12\">\n<p mbr-theme-style=\"display-4\" mbr-if=\"showText\" class=\"mbr-text mbr-black align-left pb-4 mbr-regular mbr-light mbr-fonts-style\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam dignissim quis mi eu tristique. Cras et massa erat. Quisque tempus, dolor sit amet ultrices mattis.</p>\n</div>\n<div data-for=\"first-name\" class=\"col-lg-6 form-group\">\n<input type=\"text\" name=\"first-name\" placeholder=\"Twoje imę*\" data-form-field=\"first-name\" mbr-theme-style=\"display-4\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"phone\" class=\"col-lg-6 form-group\">\n<input type=\"tel\" name=\"phone\" placeholder=\"Numer telefonu*\" pattern=\"*\" data-form-field=\"phone\" mbr-theme-style=\"display-4\" class=\"form-control\" required=\"required\" value>\n</div>\n<div data-for=\"email\" class=\"col-lg-6 form-group\">\n<input type=\"email\" name=\"email\" placeholder=\"Twój e-mail *\" data-form-field=\"email\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\" value>\n</div>\n<div class=\"col-lg-6 col-md-12 col-sm-12 form-group\" data-for=\"select1\">\n<select name=\"select1\" data-form-field=\"select\" mbr-theme-style=\"display-7\" class=\"form-control form-select\">\n<option value=\"Pakiet Standard - efektywna wizytówka*\">Pakiet Standard - efektywna wizytówka*</option>\n<option value=\"Pakiet Business - kompletna strona www\">Pakiet Business - kompletna strona www</option>\n<option value=\"Pakiet Premium - strona która zdobywa klientów\">Pakiet Premium - strona która zdobywa klientów</option>\n</select>\n</div>\n<div data-for=\"select\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"select\" class=\"form-control-label mbr-fonts-style\"><b>Czy masz już projekt strony?</b></label>\n<select name=\"select\" data-form-field=\"select\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control form-select\">\n<option value=\"Tak\">Tak</option>\n<option value=\"Nie, potrzebuje prototypu\">Nie, potrzebuje prototypu</option>\n</select>\n</div>\n<div data-for=\"radio\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<div class=\"form-control-label\">\n<label mbr-text mbr-theme-style=\"display-7\" for=\"radio\" class=\"mbr-fonts-style\"><b>Dodatek*</b></label>\n</div>\n<div class=\"form-check form-check-inline\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Mini-Pakiet Opieka i Rozwój WWW\" checked>\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\"><b>Mini-Pakiet Opieka i Rozwój WWW</b></label>\n</div>\n<div class=\"form-check form-check-inline\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Pakiet Focus na Marketing\">\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\"><b>Pakiet Focus na Marketing</b></label>\n</div>\n<div class=\"form-check form-check-inline\">\n<input type=\"radio\" name=\"radio\" data-form-field=\"radio\" mbr-theme-style=\"display-7\" class=\"form-check-input\" value=\"Żaden\">\n<label mbr-text mbr-theme-style=\"display-7\" class=\"form-check-label\">Żaden</label>\n</div>\n</div>\n<div data-for=\"Wiadomość\" class=\"col-lg-12 form-group\">\n<label mbr-text mbr-theme-style=\"display-4\" for=\"Wiadomość\" class=\"form-control-label mbr-fonts-style\"><b>np. jestem life coachem, potrzebuję strony wizytówki</b></label>\n<textarea name=\"Wiadomość\" placeholder=\"Napisz kilka słów o sobie ..\" data-form-field=\"Wiadomość\" mbr-theme-style=\"display-4\" required=\"required\" class=\"form-control\"></textarea>\n</div>\n<div mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-lg-4 col-md-12 col-sm-12 mbr-section-btn\"><a type=\"submit\" class=\"btn btn-form btn-primary\" data-app-placeholder=\"Type Text\">wyślij</a></div>\n</div>\n</form></div>\n\n\t\t\t<div class=\"col-lg-6 second\">\n\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/your-company-upscayl-5x-digital-art-4x.webp\" alt=\"wybierz_pakiet_business\">\n\t\t\t\t<div class=\"inbox\">\n\t\t\t\t\t<div class=\"inbox-box\">\n\t\t\t\t\t\t<div class=\"info-widget\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"widget-icon mbr-iconfont mbri-sale\" style=\"font-size: 19px; color: rgb(0, 0, 0); fill: rgb(0, 0, 0);\"></span>\n\t\t\t\t\t\t\t<div class=\"widget-content\" mbr-theme-style=\"display-4\">\n\t\t\t\t\t\t\t\t<p class=\"widget-title mbr-fonts-style mbr-semibold\" data-app-selector=\".widget-title, .widget-icon\" mbr-theme-style=\"display-7\">PROMOCJA<br></p>\n\t\t\t\t\t\t\t\t<p class=\"widget-text mbr-fonts-style mbr-bold\" data-app-selector=\".widget-text\" mbr-theme-style=\"display-4\">\n\t\t\t\t\t\t\t\t\tWYBIERZ&nbsp;<span style=\"font-weight: normal;\">BUSINESS</span>, A DWIE E-MAIL KREACJE MASZ ZA FREE&nbsp; 🎁&nbsp;</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t</div>\n</section>",
