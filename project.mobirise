            "background": "@bgColor",
            ".video-block": {
              "margin": "auto"
            },
            "@media (max-width: 768px)": {
              ".video-block": {
                "width": "100% !important"
              },
              ".btn": {
                "margin": "0.5rem 0.5rem"
              }
            },
            ".underline": {
              "margin-top": "-0.5rem",
              "margin-bottom": "1rem",
              ".line": {
                "width": "3rem",
                "height": "2px",
                "background": "@underlineColor",
                "display": "inline-block"
              }
