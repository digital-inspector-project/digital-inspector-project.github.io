        {
          "_name": "content02",
          "_sourceTheme": "laborm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#000000"
            },
            "@media (min-width: 1400px)": {
              ".container": {
                "max-width": "1000px"
              }
            },
            ".line": {
              "border-top": "2px dashed #ffffff",
              "padding-bottom": "2rem",
              "margin-top": "1rem"
            },
            ".mbr-section-title": {
