        },
        {
          "_name": "features002",
          "_sourceTheme": "industrym4",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".content-block": {
              "max-width": "350px",
              "padding": "4rem 3rem",
              "z-index": "5",
              "position": "relative"
            },
            ".block2": {
              "background-image": "url(@img2)",
              "&:hover": {
                ".block2-over": {
                  "opacity": "0"
                }
              }
            },
            ".block1": {
              "background-image": "url(@img3)",
              "&:hover": {
                ".block1-over": {
                  "opacity": "0"
                }
              }
            },
            ".block1-over": {
              "position": "absolute",
              "transition": "all 0.6s",
              "width": "100%",
              "background-color": "@color1",
              "opactiy": "1",
              "height": "100%",
              "top": "0",
              "left": "0"
            },
            ".block2-over": {
              "position": "absolute",
              "transition": "all 0.6s",
              "width": "100%",
              "background-color": "@color2",
              "opactiy": "1",
              "height": "100%",
              "top": "0",
              "left": "0"
            },
            ".img-content": {
              "position": "absolute",
              "width": "100%",
              "bottom": "0",
              "left": "0%",
              "height": "100%",
              "opacity": "0",
              "transition": "all 0.3s",
              "transition-delay": "0s",
              "background-image": "url(@img)",
              "background-position": "center",
              "background-size": "cover",
              "z-index": "1"
            },
            ".overlay": {
              "transition": "all 0.3s",
              "transition-delay": "0.3s",
              "width": "0%",
              "height": "100%",
              "top": "0",
              "right": "0",
              "position": "absolute",
              "background": "@color"
            },
            ".wrap": {
              "width": "100%",
              "min-height": "400px",
              "position": "relative",
              "display": "flex",
              "justify-content": "flex-end",
              "&:hover": {
                ".overlay": {
                  "width": "100%",
                  "transition-delay": "0s"
                },
                ".img-content": {
                  "opacity": "1",
                  "transition-delay": "0.3s"
                },
                ".box-title2, .box-text2": {
                  "color": "@hover",
                  "transition-delay": "0.3s"
                },
                ".box-content": {
                  "transition-delay": "0.3s",
                  "background": "transparent"
                }
              }
            },
            ".box-title2, .box-text2": {
              "transition": "all 0.3s",
              "transition-delay": "0s"
            },
            ".box-content": {
              "transition": "all 0.3s",
              "background": "@color",
              "width": "50%"
            },
            ".content-box": {
              "padding": "4rem 3rem",
              "z-index": "2",
              "position": "relative"
            },
            ".lolo-box": {
              "padding": "4rem 3rem",
              "position": "relative"
            },
            "@media (max-width: 767px)": {
              ".img-content": {
                "opacity": "1"
              },
              ".box-title2, .box-text2": {
                "color": "@hover !important"
              },
              ".content-block, .content1": {
                "padding": "3rem 1rem"
              },
              ".wrap": {
                "min-height": "300px"
              },
              ".box-content": {
                "width": "100%",
                "background": "transparent"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".box-text2": {
              "text-align": "right",
              "color": "#232323"
            },
            ".block1-text, .mbr-section-btn": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".block2-subtitle": {
              "color": "#000000",
              "text-align": "center"
            },
            ".block2-text, .mbr-section-btn": {
              "color": "#cccccc",
              "text-align": "center"
            },
            ".box-title2": {
              "color": "#333333"
            }
          },
          "_customHTML": "<section class=\"features2 industrym4_features2\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n\t\t<input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\">\n\t\t<input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n\t\t<input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\t\t<input type=\"image\" name=\"img\" title=\"Center Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1-1920x1478.jpg\" parallax>\n\t\t<input type=\"image\" name=\"img2\" title=\"Right Block Image\" value=\"@PROJECT_PATH@/assets/images/vncnb-1-256x331.png\" parallax>\n\t\t<input type=\"image\" name=\"img3\" title=\"Left Block Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1280.jpg\" parallax>\n\t\t<input type=\"color\" name=\"color1\" title=\"Left Block Color\" value=\"#290938\" selected>\n\t\t<input type=\"color\" name=\"color\" title=\"Center Block Color\" value=\"#ffffff\" selected>\n\t\t<input type=\"color\" name=\"color2\" title=\"Right Block Color\" value=\"#290938\" selected>\n\t\t<input type=\"color\" name=\"hover\" title=\"Center Text Hover Color\" value=\"#fcf5e6\" selected>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1055.png\" parallax selected>\n\t\t\t<input type=\"color\" title=\"Background Color\" value=\"#efeeee\">\n\t\t\t<input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-26.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f7\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.4\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"container-fluid\">\n\t\t<div class=\"row\">\n\t\t\t<div class=\"col-lg-3 col-md-12 block1 align-left\">\n\t\t\t\t<div class=\"block1-over\"></div>\n\t\t\t\t<div class=\"content-block\">\n\t\t\t\t\t<h3 class=\"mbr-section-subtitle block1-subtitle mbr-medium mbr-black pb-2 mbr-fonts-style\" data-app-selector=\".block1-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\">\n\t\t\t\t\t\tDistribution</h3>\n\t\t\t\t\t<h2 class=\"mbr-section-title block1-title mbr-semibold mbr-black pb-4 mbr-fonts-style\" data-app-selector=\".block1-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Industry\n\t\t\t\t\t\tEfficiency</h2>\n\t\t\t\t\t<p class=\"mbr-text mbr-black block1-text mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".block1-text, .mbr-section-btn\">JESTEŚ BIZNESEM ONLINE?<br></p>\n\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn pt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"https://digitalninja-project.github.io/\" data-app-placeholder=\"Type Text\" target=\"_blank\">KLIK</a></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-lg-6 col-md-12 col align-left\">\n\t\t\t\t<div class=\"row h-100\">\n\t\t\t\t\t<div class=\"wrap\">\n\t\t\t\t\t\t<div class=\"overlay\"></div>\n\t\t\t\t\t\t<div class=\"img-content\"></div>\n\t\t\t\t\t\t<div class=\"box-content\">\n                            <div class=\"lolo-box\"><h3 class=\"box-text2 mbr-regular mbr-white pb-2 mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".box-text2\">ZAPRASZAM!</h3></div>\n\t\t\t\t\t\t\t<div class=\"content-box\">\n\t\t\t\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-lg-3 col-md-12 block2 align-left\">\n\t\t\t\t<div class=\"block2-over\"></div>\n\t\t\t\t<div class=\"content-block\">\n\t\t\t\t\t<h3 class=\"mbr-section-subtitle block2-subtitle mbr-medium mbr-black pb-2 mbr-fonts-style\" data-app-selector=\".block2-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubTitle\">WEJDZ TERAZ<br></h3>\n\t\t\t\t\t<h2 class=\"mbr-section-title block2-title mbr-semibold mbr-black pb-4 mbr-fonts-style\" data-app-selector=\".block2-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Industry\n\t\t\t\t\t\tEfficiency</h2>\n\t\t\t\t\t<p class=\"mbr-text mbr-black block2-text mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".block2-text, .mbr-section-btn\">JESTEŚ AGENCJĄ MEDIOWĄ?</p>\n\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn pt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-white-outline\" href=\"audyt-na-start.html#top\" data-app-placeholder=\"Type Text\">KLIK</a></div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
