            }
          },
          "_customHTML": "<section class=\"content07 carm4_content07\" group=\"Content\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\" plugins=\"mobirise-icons2\">\n    <mbr-parameters>\n        \n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"15\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Main Subtitle\" name=\"showSubTitle\">\n        <input type=\"checkbox\" title=\"Text Blocks Titles\" name=\"showTextBlocksTitles\" checked>\n        <input type=\"checkbox\" title=\"Text Blocks\" name=\"showTextBlocks\" checked>\n        <input type=\"color\" title=\"List bg color\" name=\"listBgColor\" value=\"#300344\">\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"checkbox\" title=\"List Icon\" name=\"showCounter\" condition=\"showList\" checked>\n        <input type=\"color\" title=\"List Icon Color\" name=\"counterColor\" value=\"#510872\" condition=\"showCounter&&showList\">\n        <input type=\"color\" title=\"Icon Bg Color\" name=\"counterBgColor\" value=\"#ffffff\" condition=\"showCounter&&showList\">\n        <input type=\"checkbox\" title=\"Content reverse\" name=\"reverse\" checked>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1-43.jpg\" parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-43.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n        <div class=\"row\">\n            <div class=\"col-lg-5\">\n                <div class=\"content-left-wrapper align-left\">\n                    <h1 class=\"mbr-section-title mbr-bold mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".content-left-wrapper .mbr-section-title\">&nbsp;ZOSTAW KONKURENCJĘ&nbsp;<br>DALEKO W TYLE</h1>\n                    <p class=\"subtitle mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubTitle\" data-app-selector=\".content-left-wrapper .subtitle\">CZAS NA WIĘKSZĄ WIDOCZNOŚĆ\n                    </p>\n                    <div class=\"text-wrap row mt-5\" mbr-if=\"showTextBlocks\">\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-2 textBlockTitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\" data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\"><b>Czas na Inwestycję</b><br></p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\" data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Postaw na&nbsp; sprawdzone rozwiązania, które przynoszą sukces..</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\" data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\"><b>Elastyczne działania</b><br></p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\" data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Dostosowuje rozwiązania do Twoich potrzeb, marki oraz możliwości.</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\" data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\"><b>Pewność i jakości</b><br></p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\" data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">\"Dbamy o spójność, poprawność i wartość merytoryczną treści.</p>\n                        </div>\n                        <div class=\"col-12 col-md-6\">\n                            <p class=\"mbr-text mbr-white mbr-regular mbr-white mbr-fonts-style mb-0 textBlockTitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTextBlocksTitles\" data-app-selector=\".content-left-wrapper .text-wrap .textBlockTitle\"><b>Rezultaty, które sprzedają</b><br></p>\n                            <p class=\"mbr-text textBlock mbr-white mbr-light mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTextBlocks\" data-app-selector=\".content-left-wrapper .text-wrap .textBlock\">Twoja oferta staje się widoczna, i skutecznie zachęca do zakupu.<br><br></p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-lg-7 col-12 pl-lg-5\">\n                <div class=\"content-right-wrapper align-left\">\n                    <p class=\"mbr-text mbr-white mbr-bold mbr-white mbr-fonts-style px-3\" mbr-theme-style=\"display-5\" mbr-if=\"showListTitle\" data-app-selector=\".content-right-wrapper .mbr-text\">\n                        Dlaczego warto zacząć ze Mną ?</p>\n                    <div class=\"text-wrap row justify-content-center\" mbr-if=\"showTextBlocks\">\n                        <div class=\"col-sm-6 col-12\">\n                            <div class=\"mbr-list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".content-right-wrapper .text-wrap .mbr-list\" data-multiline mbr-article mbr-if=\"showList\">\n                                <ul class=\"list\" mbr-if=\"showList\">\n                                    <li>Zweryfikuję&nbsp; konkurencje.</li>\n                                    <li>Jak działa u ciebie Algorytm Google.</li>\n                                    <li>Budowa wizerunku eksperta.</li>\n                                </ul>\n                            </div>\n                        </div>\n                        <div class=\"col-sm-6 col-12\">\n                            <div class=\"mbr-list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".content-right-wrapper .text-wrap .mbr-list\" data-multiline mbr-article mbr-if=\"showList\">\n                                <ul class=\"list\" mbr-if=\"showList\">\n                                    <li><span style=\"font-size: 0.8rem;\">Stabilne pozycje = wyższa konwersja</span></li>\n                                    <li>Perspektywa efektów</li>\n                                    <li>Wzrost rozpoznawalności odbiorców.</li></ul><ul class=\"list\" mbr-if=\"showList\">\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
