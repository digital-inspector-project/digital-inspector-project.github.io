                "max-width": "1400px"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#20002e",
              "font-weight": "600",
              "margin-bottom": "21px",
              "&.display-4": {
                "line-height": "1.375"
              },
              "text-align": "right"
