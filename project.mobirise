            "img": {
              "width": "100%"
            },
            ".card-wrapper": {
              "background-position": "center",
              "border-radius": "4px",
              "padding": "0",
              "cursor": "pointer",
              "transition": "all 0.3s",
              "background-size": "cover",
              "display": "flex !important",
              "flex-direction": "row !important",
              "justify-content": "center !important",
              "align-items": "center",
              ".card-count": {
                "height": "100%",
                "margin-right": "25px",
                ".icon-count": {
                  "background-color": "fade(@countColor, 25%)",
                  "width": "40px",
                  "height": "40px",
                  "border-radius": "100%",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "position": "relative",
                  "color": "@countColor"
                }
              },
              ".card-box": {
                "height": "100%",
                ".card-title": {
                  "color": "#404040",
                  "margin-bottom": "12px",
                  "font-weight": "600",
                  "&.display-7": {
                    "line-height": "1.3"
                  }
                },
                ".mbr-text": {
                  "color": "#606060",
                  "&.display-4": {
                    "line-height": "1.75"
                  }
                },
                ".link-wrap": {
                  "width": "100%",
                  ".link": {
                    "display": "inline-block",
                    "a": {
                      "position": "relative",
                      "width": "fit-content",
                      "display": "inline-block",
                      "padding-right": "0.6rem",
                      "font-weight": "600",
                      "&:before": {
                        "position": "absolute",
                        "transition": "all 0.3s",
                        "right": "0px",
                        "top": "55%",
                        "opacity": "0",
                        "transform": "translateY(-50%)",
                        "content": "\"\\e909\"",
                        "font-family": "\"Moririse2\" !important",
