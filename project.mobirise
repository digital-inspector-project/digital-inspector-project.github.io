    "index.html": {
      "settings": {
        "main": true,
        "title": "Oparte o prototyp | Tworzę unikalne Strony WWW",
        "meta_descr": "Zobacz interaktywny prototyp swojej strony WWW. Akceptuj design, który możesz przeklikać. 🎁 Promocja: -20% dla pierwszych 3 klientów miesięcznie. Sprawdź!",
        "header_custom": "<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    overflow: scroll; /* Pozwala przewijać */\n    scrollbar-width: none; /* Ukrywa paski w Firefox */\n  }\n\n  body::-webkit-scrollbar {\n    display: none; /* Ukrywa paski w Chrome, Safari i Edge */\n  }\n</style>",
        "footer_custom": "<script>\nfunction scrollToSectionFromQuery() {\n    // Sprawdź, czy w adresie jest cokolwiek po znaku \"?\"\n    if (window.location.search) {\n        // Weź wartość po \"?\", np. \"?pytania-i-odpowiedzi\" i usuń \"?\"\n        const sectionName = window.location.search.substring(1);\n        \n        if (sectionName) {\n            try {\n                // Znajdź element o ID pasującym do tej nazwy\n                const targetElement = document.getElementById(sectionName);\n                \n                if (targetElement) {\n                    // Przewiń do znalezionego elementu\n                    targetElement.scrollIntoView({ behavior: 'auto' });\n                } else {\n                    // To pomoże w diagnozie - sprawdź konsolę (F12)\n                    console.log(\"SKRYPT LINKOWANIA: Nie znaleziono elementu o ID:\", sectionName);\n                }\n            } catch (e) {\n                console.error(\"SKRYPT LINKOWANIA: Błąd podczas przewijania:\", e);\n            }\n        }\n    }\n}\n\n// ZMIANA: Użyj 'load' zamiast 'DOMContentLoaded'.\n// 'load' uruchomi się dopiero, gdy cała strona, w tym wszystkie skrypty Mobirise,\n// będzie w 100% gotowa.\nwindow.addEventListener('load', function() {\n    scrollToSectionFromQuery();\n});\n</script>",
        "html_before": ""
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@sticky)": {
