        {
          "_name": "news1",
          "_sourceTheme": "estatem5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            ".timeline-element": {
              "position": "relative"
            },
            ".timelines-container": {
              "display": "flex",
              "flex-wrap": "wrap",
              "justify-content": "center",
              ".timeline-element": {
                ".nth-order": {
                  "display": "flex",
                  "align-items": "flex-end",
                  "flex-direction": "column",
                  "@media (max-width: 768px)": {
                    "align-items": "flex-start"
                  }
                },
                "&:nth-child(2n)": {
                  ".nth-order": {
                    "align-items": "flex-start",
                    "@media (min-width: 768px)": {
                      "order": "2"
                    }
                  }
                }
              },
              "& when (@reverseTimeline)": {
                "flex-direction": "column-reverse"
              }
            },
            ".mbr-section-title, .mbr-section-subtitle, .timeline-date": {
              "text-align": "center"
            },
            ".iconBackground": {
              "position": "absolute",
              "width": "20px",
              "height": "20px",
              "border-radius": "50%",
              "background": "@lineColor",
              "margin-left": "-9px",
              "padding": "0",
              "@media (max-width: 767px)": {
                "left": "15px"
              },
              "@media (min-width: 768px)": {
                "left": "50%"
              }
            },
            ".row": {
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "background-color": "@lineColor",
                "width": "2px",
                "@media (max-width: 767px)": {
                  "height": "calc(100% ~\"+\" 30px)",
                  "top": "20px",
                  "left": "15px"
                },
                "@media (min-width: 768px)": {
                  "& when (@showDates)": {
                    "height": "calc(100% ~\"-\" 20px)"
                  },
                  "& when not (@showDates)": {
                    "height": "calc(100% ~\"+\" 28px)"
                  },
                  "top": "20px",
                  "left": "50%"
                }
              }
            },
            ".timeline-content": {
              "background": "@CardsColor",
              "border-radius": "16px"
            },
            "@media (max-width: 767px)": {
              ".timeline-content": {
                "padding": "1rem"
              },
              ".timeline-date-wrapper, .timeline-text-wrapper": {
                "padding": "0rem",
                "padding-left": "2rem"
              },
              ".nth-order": {
                "margin": "4rem 0 1rem 0"
              },
              ".mbr-timeline-date": {
                "text-align": "left !important"
              },
              ".mbr-timeline-title": {
                "text-align": "left",
                "margin-top": "1rem"
              }
            },
            "@media (max-width: 991px) and (min-width: 768px)": {
              ".timeline-content": {
                "padding": "1rem"
              },
              ".timeline-date-wrapper, .timeline-text-wrapper": {
                "padding": "1rem"
              }
            },
            "@media (min-width: 992px)": {
              ".timeline-content": {
                "padding": "2rem"
              },
              ".timeline-date-wrapper, .timeline-text-wrapper": {
                "padding": "2rem"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"news1\" group=\"News\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"checkbox\" title=\"Reverse Timeline\" name=\"reverseTimeline\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Dates\" name=\"showDates\" checked>\n        <select title=\"Count\" name=\"timelinesAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n            <option value=\"10\">10</option>\n            <option value=\"11\">11</option>\n            <option value=\"12\">12</option>\n        </select>\n        <input type=\"color\" name=\"lineColor\" title=\"Line Color\" value=\"#efefef\">\n        <input type=\"color\" name=\"CardsColor\" title=\"Cards Color\" value=\"#efefef\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n        \n        \n        \n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"mbr-section-head mb-5\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><br>Jaki&nbsp; jest mój obecny klient ?</h3>\n            <h4 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0 mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Subtitle\n            </h4>\n        </div>\n        <div class=\"timelines-container mt-4\">\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-date\">\n                                Mały biznes <br>usługowy i produktowy</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Elastyczne wsparcie</b></h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">Klient, który nie ma własnego,&nbsp; działu marketingu cyfrowego i potrzebuje wsparcia przy swoich najważniejszych projektach w roku.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>1\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                Twórcy online / self-publishers</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Potrzebuje wzrostu</b></h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Eksperci w swojej dziedzinie (dietetyk, nauczyciel, trener, life coach), którzy spędzili miesiące, tworząc produkt cyfrowy, ale teraz staje przed ścianą i pyta: \"I co teraz? Jak to sprzedać?\".\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>2\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                Indywidualny</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\"><b>Zerowe wsparcie wydawcy</b></h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Osoba, która podpisała umowę z wydawnictwem (małym lub średnim) lub wydaje książkę samodzielnie (self-publishing). Napisała dzieło życia, ale wydawca daje jej zerowe wsparcie marketingowe. Boi się, że książka zniknie w gąszczu nowości.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>3\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>4\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>5\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>6\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>7\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>8\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>9\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>10\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>11\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row timeline-element first-separline\" mbr-class=\"{'reverseTimeline': reverseTimeline}\" mbr-if=\"timelinesAmount>12\">\n                <span class=\"iconBackground\"></span>\n                <div class=\"nth-order col-12 col-md-6\">\n                    <div class=\"timeline-date-wrapper\" mbr-if=\"showDates\">\n                        <div class=\"timeline-content container\">\n                            <p class=\"mbr-date mbr-fonts-style m-0\" mbr-theme-style=\"display-5\" mbr-if=\"showDates\" data-app-selector=\".mbr-date\">\n                                23 April 2025</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-12 col-md-6\">\n                    <div class=\"timeline-text-wrapper\">\n                        <div class=\"timeline-content container\">\n                            <h4 class=\"mbr-timeline-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-timeline-title\">\n                                <b>Title</b>\n                            </h4>\n                            <p class=\"mbr-text mbr-fonts-style mt-3 mb-0\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\">\n                                Cupidatat occaecat quis dolor deserunt anim reprehenderit sint et enim incididunt fugiat\n                                ipsum consequat quis. Eu cupidatat dolore tempor ut aliquip sunt cupidatat sit aute\n                                incididunt anim amet. Consectetur ut proident ea deserunt.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "news1-c9",
          "_isUserblock": true,
          "_cid": "v29o4WT7R8",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afeatures3",
          "_sourceTheme": "bootcampm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 0.5rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".container": {
              "max-width": "1280px"
            },
            ".content-wrapper": {
              "background": "@cardColor",
              "padding": "4rem",
              "border-radius": "4.17rem",
              "@media (max-width: 767px)": {
                "padding": "4rem 6vw"
              }
            },
            ".text-wrapper": {
              "width": "100%",
              "margin-bottom": "32px",
              "@media (max-width: 767px)": {
                "margin-bottom": "24px"
              }
            },
            ".card-title": {
              "color": "#FFDD65"
            },
            ".img-container": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "stretch",
              "margin-bottom": "1.67rem",
              "@media (max-width: 767px)": {
                "flex-wrap": "wrap",
                "margin-bottom": "16px"
              }
            },
            ".item-container": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "width": "45%",
              "margin-right": "0.83rem",
              "margin-left": "0.83rem",
              "padding": "2.5rem",
