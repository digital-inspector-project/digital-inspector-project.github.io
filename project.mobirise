        {
          "_name": "agallery1",
          "_sourceTheme": "mediam5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "margin-bottom": "2rem",
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#181817"
            },
            ".mbr-section-subtitle": {
              "color": "#181817",
              "margin-top": "1rem"
            },
            ".card-row": {
              "align-items": "stretch"
            },
            ".item": {
              "margin-bottom": "2rem",
              "@media (min-width: 1400px)": {
                "width": "(100% / @columnCount) !important"
              },
              "@media (min-width: 768px)": {
                "& when (@columnCount < 3)": {
                  "width": "(100% / @columnCount) !important"
                }
              }
            },
            ".item-wrapper": {
              "display": "flex",
              "align-items": "flex-end",
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "border-radius": "1.5rem",
              "border": "1px ",
              "color": "white",
              "overflow": "hidden",
              "padding-top": "20px",
              "min-height": "(@imgHeight * 235px)",
              "@media (max-width: 991px)": {
                "min-height": "(@imgHeight * 180px)"
              },
              "& when (@hoverEffect)": {
                "&:hover": {
                  ".card-box": {
                    "opacity": "0"
                  },
                  ".bg-overlay": {
                    "display": "flex",
                    "&:hover": {
                      ".mbr-section-btn": {
                        "transform": "translateY(0)",
                        "opacity": "1"
                      }
                    }
                  },
                  ".bg-overlay-color": {
                    "opacity": "0.8"
                  }
                }
              }
            },
            ".item-img": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "2",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              }
            },
            ".card-box": {
              "position": "relative",
              "z-index": "3",
              "padding": "8rem 1.5rem 1.5rem",
              "background-image": "linear-gradient(180deg, rgba(24, 24, 23, 0), rgba(24, 24, 23, 0.9) 65%)",
              "transition": "0.4s all",
              "opacity": "1"
            },
            ".card-title": {
              "color": "#f6f6ef",
              "margin-bottom": "0.6rem",
              "text-align": "left"
            },
            ".card-subtitle": {
              "color": "#f6f6ef",
              "margin-bottom": "1rem",
              "margin-top": "0 !important"
            },
            ".card-text": {
              "color": "#f6f6ef",
              "margin-bottom": "0"
            },
            ".card-text-container": {
              "display": "flex",
              "align-items": "center",
              "padding-top": "0.5rem"
            },
            ".iconfont-wrapper": {
              "margin-right": "18px",
              ".mbr-iconfont": {
                "display": "block",
                "font-size": "20px",
                "color": "@iconColor",
                "width": "fit-content"
              }
            },
            ".bg-overlay": {
              "display": "none",
              "flex-direction": "column",
              "align-items": "stretch",
              "justify-content": "center",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "z-index": "4"
            },
            ".bg-overlay-color": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "#181817",
              "opacity": "0",
              "z-index": "5",
              "transition": "0.4s all"
            },
            ".mbr-section-btn": {
              "position": "relative",
              "z-index": "6",
              "transform": "translateY(2rem)",
              "transition": "0.4s all",
              "opacity": "0",
              "padding": "0 1rem",
              ".btn": {
                "box-shadow": "none !important"
              },
              "@media (max-width: 575px)": {
                "width": "auto",
                "& .btn": {
                  "width": "auto",
                  "min-width": "auto !important"
                }
              }
            }
          },
          "_customHTML": "<section class=\"gallery1 mediam5\" group=\"Gallery & Slider\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Image Height\" name=\"imgHeight\" min=\"1\" max=\"4\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Column Count\" name=\"columnCount\" min=\"2\" max=\"5\" step=\"1\" value=\"4\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\">\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Hover Effect\" name=\"hoverEffect\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffcd40\" selected condition=\"showIcon\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n        \n        \n        \n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        <b>\n                            SEM VIVERRA ALIQUET\n                        </b>\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        Mauris pellentesque pulvinar pellentesque habitant morbi tristique senectus et.\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/ewa2-401x711.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Sapien pellentesque habitant\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Auctor elit sed\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                20M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://swoimszlakiem-sklep.github.io/Wireless_Earbuds\" class=\"btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\">ZOBACZ PROJEKT</a></div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/beard1-401x690.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Platea dictumst quisque\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Nec feugiat nisl\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                13M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://swoimszlakiem-sklep.github.io/BEARDGROWTHKIT/\" class=\"btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\">ZOBACZ PROJEKT</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/nx70001-400x711.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Fames ac turpis egestas\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Lacus vel facilisis\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                8M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://swoimszlakiem-sklep.github.io/NX-7000\" class=\"btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\">ZOBACZ PROJEKT</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/plecakactive-398x708.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Maecenas volutpat blandit\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Auctor augue\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                25M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://swoimszlakiem-sklep.github.io/activebag\" class=\"btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\">ZOBACZ PROJEKT</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12 col-sm-6 col-md-4 col-xl-4\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/nx80001-397x707.png\" alt=\"Mobirise Website Builder\">\n                    </div>\n                    <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showIcon || showText\">\n                        <h5 class=\"card-title align-left mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                            Elementum nisi quis\n                        </h5>\n                        <h6 class=\"card-subtitle align-left mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                            Varius vel pharetra\n                        </h6>\n                        <div class=\"card-text-container\">\n                            <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-play mobi-mbri\"></span>\n                            </div>\n                            <p class=\"card-text align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                17M VIEWS\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"bg-overlay\">\n                        <div class=\"bg-overlay-color\"></div>\n                        <div class=\"mbr-section-btn align-center\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\" mbr-buttons mbr-theme-style=\"display-7\"><a href=\"https://swoimszlakiem-sklep.github.io/NX-8000/\" class=\"btn btn-warning\" target=\"_blank\" data-app-placeholder=\"Type Text\">ZOBACZ PROJEKT</a></div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
