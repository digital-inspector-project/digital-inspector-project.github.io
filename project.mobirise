          "_once": false,
          "_params": {}
        },
        {
          "_name": "content02",
          "_sourceTheme": "laborm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".mbr-text": {
              "color": "#000000",
              "text-align": "left"
            },
            "@media (min-width: 1400px)": {
              ".container": {
                "max-width": "1000px"
              }
            },
            ".line": {
              "border-top": "2px dashed #20002e",
              "padding-bottom": "2rem",
              "margin-top": "1rem"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content2\" group=\"Content\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"4\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"range\" inline title=\"Items\" name=\"rows\" min=\"1\" max=\"4\" step=\"1\" value=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        \n         <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    \n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"line\"></div>\n            </div>\n            <div class=\"col-12 col-lg-3\">\n                <h5 class=\"mbr-section-title align-left mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><br>Co można zrobić lepiej ?</h5>\n                <h6 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    Subtitle</h6>\n            </div>\n            <div class=\"col-md-12 col-lg-9\">\n                <p class=\"mbr-text align-left mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\"><br>Wyobraź sobie sytuację, w której po <b>Analizie Strategii</b>&nbsp;i dopracowaniu <b>Treści </b>twoja strona jest gotowa na przyjęcie nowych odbiorców. Zainwestowałeś czas i środki w kompleksowe działania, aby&nbsp;maksymalnie wykorzystać szansę na zwiększenie zasięgu i widoczności w sieci, <br><br>ale :<br><br>brakuje Ci tylko jednego kluczowego elementu, który scali wszystkie działania w spójny i skuteczny proces sprzedażowy sprzedającego, landing page’a, na którym użytkownik nie tylko przeczyta o ofercie, ale także podejmie decyzję o zakupie. To ważne aby strona była czymś więcej i miała swój indywidualny styl.<br></p>\n            </div>\n        </div>\n\n        <div class=\"row\" mbr-if=\"rows > 1\">\n            <div class=\"col-12\">\n                <div class=\"line\"></div>\n            </div>\n            <div class=\"col-12 col-lg-3\">\n                <h5 class=\"mbr-section-title align-left mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><b>Wood Construction</b></h5>\n                <h6 class=\"mbr-section-subtitle align-left mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    Subtitle</h6>\n            </div>\n            <div class=\"col-md-12 col-lg-9\">\n                <p class=\"mbr-text align-left mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-5\">Brakuje Ci tylko jednego kluczowego elementu, który scali wszystkie działania w spójny i skuteczny proces sprzedażowy sprzedającego, landing page’a, na którym użytkownik nie tylko przeczyta o ofercie, ale także podejmie decyzję o zakupie. To ważne aby strona była czymś więcej i miała swój indywidualny styl. </p>\n            </div>\n        </div>\n\n        <div class=\"row\" mbr-if=\"rows > 2\">\n            <div class=\"col-12\">\n                <div class=\"line\"></div>\n            </div>\n            <div class=\"col-12 col-lg-3\">\n                <h5 class=\"mbr-section-title align-left mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><b>Industrial Design</b></h5>\n                <h6 class=\"mbr-section-subtitle align-left mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    Subtitle</h6>\n            </div>\n            <div class=\"col-md-12 col-lg-9\">\n                <p class=\"mbr-text align-left mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam nec\n                    lacus non leo luctus sollicitudin. Curabitur sit amet turpis eu sapien consectetur tincidunt. Duis\n                    laoreet sem eu massa sollicitudin convallis. Ut efficitur eu eros ut vestibulum. Nulla facilisi.\n                    Donec ut ultricies sem. Morbi vel urna quis dui euismod pharetra. </p>\n            </div>\n        </div>\n\n        <div class=\"row\" mbr-if=\"rows > 3\">\n            <div class=\"col-12\">\n                <div class=\"line\"></div>\n            </div>\n            <div class=\"col-12 col-lg-3\">\n                <h5 class=\"mbr-section-title align-left mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><b>Web Development</b></h5>\n                <h6 class=\"mbr-section-subtitle align-left mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    Subtitle</h6>\n            </div>\n            <div class=\"col-md-12 col-lg-9\">\n                <p class=\"mbr-text align-left mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam nec\n                    lacus non leo luctus sollicitudin. Curabitur sit amet turpis eu sapien consectetur tincidunt. Duis\n                    laoreet sem eu massa sollicitudin convallis. Ut efficitur eu eros ut vestibulum. Nulla facilisi.\n                    Donec ut ultricies sem. Morbi vel urna quis dui euismod pharetra.&nbsp;</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "content02-c",
          "_isUserblock": true,
          "_cid": "uZhcXnJQr0",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
