          },
          "_customHTML": "<section class=\"footer4 agencym4_footer4\" group=\"Footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n\t\t<input type=\"checkbox\" title=\"Show Copyright\" name=\"showCopyright\" checked>\n\t\t<input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\">\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background10-1.jpg\">\n\t\t\t<input type=\"color\" title=\"Background Color\" value=\"#121212\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#3C3C3C\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"media-container-row content mbr-white\">\n\t\t\t<div class=\"col-md-3 col-sm-12\">\n\t\t\t\t<div class=\"mb-3 img-logo\">\n\t\t\t\t\t<a href=\"https://mobiri.se/\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/digital-stopka-zdjecie-192x180.png\" alt=\"Mobirise\">\n\t\t\t\t\t</a>\n\t\t\t\t</div>\n\t\t\t\t<p class=\"mb-3 mbr-fonts-style foot-title\" mbr-theme-style=\"display-7\" data-app-selector=\".foot-title, .img-logo\">\n\t\t\t\t\tDIGITAL&nbsp;<a href=\"index.html#top\" class=\"text-primary\">INSPECTOR</a></p>\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\"><a href=\"regulamin-sklepu.html?header4-1z\" class=\"text-white text-primary\">Regulamin Strony</a><br><a href=\"polityka-prywatnosci-rodo-i-cookies.html?header4-27\" class=\"text-white text-primary\">Polityka prywatności</a><br><a href=\"warunki-korzystania-ze-strony-DSA.html?header4-1v\" class=\"text-white text-primary\">Warunki Serwisu</a></p>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-4 col-sm-12\">\n\t\t\t\t<p class=\"mb-4 foot-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".foot-title, .img-logo\">Współpraca strategiczna</p>\n\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\">Współpracuję z organizacjami pozarządowymi oraz działalnościami non-profit w zakresie marketingu cyfrowego, rozwiązań i narzędzi online<br><br>&nbsp;Szukasz synergii z markami o podobnym DNA ?&nbsp; Chcesz tworzyć&nbsp;unikalne i wartościowe pomysły edukacyjne ? <br><br>Napisz <b>mini-kontakt</b><br></p>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-4 offset-md-1 col-sm-12\">\n\t\t\t\t<p class=\"mb-4 foot-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".foot-title, .img-logo\">\n\t\t\t\t\tMini-kontakt biznesowy</p>\n\t\t\t\t<div class=\"form-block\">\n\t\t\t\t\t<div mbr-form>\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t\t<form action=\"xampiotris@gmail.com\" name=\"Mobirise Form\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"xampiotris@gmail.com\">\n\t\t\t\t\t\t\t<div class=\"form-row\">\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Dziękujemy i doceniamy !\n\t\t\t\t\t\t\t\t\tfilling out the form!</div>\n\t\t\t\t\t\t\t\t<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"dragArea form-row\">\n\t\t\t\t\t\t\t\t<div class=\"col-md-12  form-group\" data-for=\"email\">\n\t\t\t\t\t\t\t\t\t<input type=\"text\" name=\"email\" placeholder=\"Email\" data-form-field=\"Email\" mbr-theme-style=\"display-7\" required=\"required\" class=\"form-control input\">\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-12  form-group\" data-for=\"message\">\n\t\t\t\t\t\t\t\t\t<textarea name=\"message\" placeholder=\"Message\" data-form-field=\"Message\" mbr-theme-style=\"display-7\" class=\"form-control input\"></textarea>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-12  align-center input-group-btn mt-2\" mbr-buttons=\"true\" mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove,-mbrBtnLink,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-bgr btn-warning\" data-app-placeholder=\"Type Text\">WYŚLIJ<br></a></div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</form>\n\t\t\t\t\t\t<!---Formbuilder Form--->\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t\t<div class=\"footer-lower\" mbr-if=\"showCopyright\">\n\t\t\t<div class=\"media-container-row\">\n\t\t\t\t<div class=\"col-sm-12\">\n\t\t\t\t\t<hr>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"media-container-row mbr-white\">\n\t\t\t\t<div class=\"col-sm-12 copyright\">\n\t\t\t\t\t<p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".copyright > p\">\n\t\t\t\t\t\t© Copyright 2025 Digital Inspector - All Rights Reserved\n\t\t\t\t\t</p>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
