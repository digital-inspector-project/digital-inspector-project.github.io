        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "background-color": "@leftSideColor",
            "& when (@reverse)": {
              ".title__block": {
                "z-index": "5"
              }
            },
            ".figure when (@showFigure)": {
              "display": "block",
              "position": "relative",
              "z-index": "1",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "z-index": "-1",
                "width": "110px",
                "height": "110px",
                "bottom": "-85px",
                "left": "-105px",
                "background-image": "url(@figure)",
                "background-repeat": "no-repeat",
                "background-size": "cover"
              }
            },
            ".link": {
              "display": "block",
              "margin-bottom": "0",
              "white-space": "nowrap",
              "padding-right": "10px",
              "margin-top": "45px",
              "text-align": "right",
              "position": "relative",
              "z-index": "5",
              "a": {
                "font-weight": "700"
              },
              "span": {
                "display": "inline-block !important",
                "transition": "all 0.3s ease",
                "margin-left": "13px"
              },
              "&:hover span": {
                "transform": "translateX(9px)"
              }
            },
            ".card__block": {
              "position": "relative",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "-128px",
                "left": "205px",
                "width": "100vw",
                "height": "~'calc(100% + 182px)'",
                "z-index": "0",
                "background-color": "@rightSideBaseColor",
                "& when (@bg-type = 'color')": {
                  "background-color": "@bg-value"
                },
                "& when (@bg-type = 'image')": {
                  "background-image": "url(@bg-value)",
                  "background-size": "cover",
                  "background-position": "center",
                  "& when (@pattern)": {
                    "background-repeat": "repeat",
                    "background-size": "30px 30px"
                  }
                }
              },
              "&:after": {
                "content": "\"\"",
                "position": "absolute",
                "top": "-128px",
                "left": "205px",
                "width": "100vw",
                "height": "~'calc(100% + 182px)'",
                "z-index": "1",
                "& when (@overlay) and not (@bg-type = 'color')": {
                  "background-color": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".card__item": {
              "max-width": "45%",
              "padding": "0 23px",
              "margin-bottom": "65px",
              "position": "relative",
              "z-index": "2"
            },
            ".card__content": {
              "position": "relative",
              "width": "100%",
              "height": "280px",
              "transition": "all .3s ease",
              "&:hover": {
                "transform": "scale(0.95)"
              },
              "img": {
                "position": "absolute",
                "height": "100%",
                "width": "100%",
                "object-fit": "cover",
                "z-index": "0"
              },
              ".card__title": {
                "z-index": "5",
                "position": "relative",
                "padding": "28px 28px 7px",
                "margin-bottom": "0",
                "pointer-events": "none"
              },
              ".card__text": {
                "z-index": "5",
                "position": "relative",
                "padding": "0 28px",
                "margin-bottom": "0",
                "pointer-events": "none",
                "& when not (@cardTitle)": {
                  "padding-top": "28px"
                }
              },
              ".is-builder & .card__title": {
                "pointer-events": "all"
              },
              ".is-builder & .card__text": {
                "pointer-events": "all"
              }
            },
            "@media (max-width: 1024px)": {
              ".figure:before": {
                "width": "60px",
                "height": "60px",
                "bottom": "-100px",
                "left": "-15px"
              },
              ".link": {
                "margin-top": "15px",
                "padding-right": "0",
                "text-align": "left"
              },
              ".title__block": {
                "margin-bottom": "74px"
              },
              ".card__block": {
                "&:before, &:after": {
                  "top": "-50px",
                  "left": "115px",
                  "height": "~'calc(100% + 90px)'"
                }
              },
              ".card__item": {
                "max-width": "348px",
                "margin": "0 auto 25px"
              }
            },
            "@media (max-width: 767px)": {
              ".card__block > [class*=\"col-\"]": {
                "padding-right": "5px",
                "padding-left": "5px"
              },
              ".card__content": {
                "height": "200px"
              },
              ".card__text": {
