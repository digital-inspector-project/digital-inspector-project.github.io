            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              "& when (@showGradient)": {
                "position": "relative",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "background-image": "linear-gradient(@grad_1 30%, @grad_2)"
                }
              }
            },
            "& when (@bg-type = 'image')": {
