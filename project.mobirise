        {
          "_name": "slider02",
          "_sourceTheme": "neuralm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "overflow": "hidden"
            },
            ".title-wrapper": {
              "margin-bottom": "40px",
              ".mbr-tag": {
                "margin-bottom": "16px"
              },
              ".mbr-section-title": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-btn": {
              ".btn": {
                "margin-top": "20px",
                "&::after, &::before": {
                  "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2 150%)"
                },
                "&:hover, &:focus": {
                  "&::after": {
                    "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2 150%)",
                    "opacity": "1"
                  },
                  "color": "@activeBtn !important"
                }
              }
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "500px",
              "max-width": "500px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "justify-content": "space-between",
                  "height": "100%",
                  "@media (max-width: 992px)": {
                    "display": "block"
                  },
                  ".number-wrap": {
                    "position": "relative",
                    "z-index": "1",
                    ".item-number": {
                      "display": "inline-block",
                      "color": "transparent",
                      "-webkit-background-clip": "text",
                      "background-image": "linear-gradient(-90deg, @gradient_1, @gradient_2)",
                      "margin-bottom": "0",
                      "margin-right": "40px",
                      "-webkit-text-fill-color": "@number",
                      "-webkit-text-stroke": "2px transparent",
                      "-webkit-text-stroke-width": "4px",
                      "text-stroke": "2px transparent",
                      "writing-mode": "vertical-lr",
                      "transform": "rotate(180deg)",
                      "margin-left": "0",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "20px",
                        "writing-mode": "inherit",
                        "transform": "none",
                        "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2)"
                      }
                    }
                  },
                  ".card-box": {
                    "position": "relative",
                    "z-index": "1",
                    "width": "70%",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    },
                    ".item-title": {
                      "margin-bottom": "16px"
                    },
                    ".item-text": {
                      "margin-bottom": "0"
                    }
                  }
                }
              }
            },
            ".arrows-wrapper": {
              "position": "absolute",
              "top": "-5.5rem",
              "right": "0",
              "border-radius": "3rem",
              "display": "flex",
              "@media (max-width: 992px)": {
                "top": "0"
              },
              "&::before": {
                "content": "''",
                "position": "absolute",
                "inset": "0",
                "padding": "2px",
                "border-radius": "inherit !important",
                "-webkit-mask": "linear-gradient(#ffffff 0 0) content-box, linear-gradient(#ffffff 0 0)",
                "background-image": "linear-gradient(90deg, @gradient_1, @gradient_2)",
                "-webkit-mask-composite": "xor",
                "mask-composite": "exclude",
                "pointer-events": "none"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "width": "48px",
              "height": "48px",
              "margin-top": "0",
              "font-size": "16px",
              "background-color": "transparent !important",
              "color": "@arrowsColor !important",
              "border": "none !important",
              "transition": "all 0.3s",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "color": "@active !important"
              },
              "&.embla__button--prev": {},
              "&.embla__button--next": {}
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "overflow": "visible",
              "& when (@arrows)": {
                "@media (max-width: 992px)": {
                  "padding-top": "6rem"
                }
              }
            },
            ".embla__viewport": {
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".btn-wrapper": {
              "margin-top": "-10%"
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-tag": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-title": {
              "color": "#ffffff"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".mbr-section-title, .main-btn": {
              "text-align": "right"
            },
            ".item-number, .number-wrap": {
              "text-align": "left"
            },
            ".item-title, .item-btn": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider02 mbr-embla neuralm5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Tag\" name=\"showTag\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"6\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" value=\"#20002e\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows Active Color\" value=\"#20002e\" name=\"active\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"1\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"checkbox\" title=\"Card Number\" name=\"showNumber\" checked>\n        <input type=\"color\" title=\"Number Color\" value=\"#121212\" name=\"number\" condition=\"showNumber\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showCardButtons\">\n        <input type=\"color\" title=\"Button Active Color\" value=\"#ffffff\" name=\"activeBtn\" condition=\"showCardButtons\" selected>\n        <header>Gradient</header>\n        <input type=\"color\" title=\"Gradient 1\" value=\"#386bb7\" name=\"gradient_1\" condition=\"showCardButtons || arrows || showNumber\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#e50eaf\" name=\"gradient_2\" condition=\"showCardButtons || arrows || showNumber\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\">\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\">\n        \n        \n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    \n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-8 card\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showTag\">\n                    <h3 class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag\" mbr-theme-style=\"display-2\" mbr-if=\"showTag\"><b>Proces współpracy&nbsp; :</b><br></h3>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .main-btn\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">&nbsp;</h2>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>01</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">Pierwszy kontakt</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">Zaraz po wypełnieniu formularz wysyłam wiadomość z ustalonym terminem na spotkania online.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>02</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                                                Briefing</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">W miedzy czasie proszę o wypełnienie briefu google forms badam tożsamość, aby zidentyfikować DNA witryny.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>03</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                                                Spotkanie online</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">Na spotkaniu omawiamy szczegóły na podstawie twojego briefu jeśli wszystko jest w porządku przechodzimy do prostej umowy na usme.com.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>04</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">Umowa</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">Generuję umowę przez useme.com oraz pobieram automatyczną zaliczka 50 %, następnie akceptujesz klauzulę procesu.<br>Czekam na ewentualne materiały.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>05</b>\n                                            </p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                                                Prototyp</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">Zaczynam tworzyć&nbsp; prototyp, i czekam na akceptację&nbsp; projektu lub przystąpienia do ewentualnych poprawek pakietowych.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div><div class=\"embla__slide slider-image item features-without-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"number-wrap\">\n                                            <p class=\"item-number mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showNumber\" data-app-selector=\".item-number, .number-wrap\">\n                                                <b>06</b></p>\n                                        </div>\n                                        <div class=\"card-box\">\n                                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title, .item-btn\">\n                                                Produkcja</h4>\n                                            <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".item-text\">Po akceptacji prototypu następuje zamrożenie struktury i koncepcji wizualnej, realizuje wdrożenie.</p>\n                                            <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn item-btn\" mbr-if=\"showCardButtons\" data-toolbar=\"-mbrBtnMove\">\n                                                <a class=\"btn btn-white-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>\n                                                    View more\n                                                </a>\n                                            </div>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"arrows-wrapper\">\n                        <button class=\"embla__button embla__button--prev\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                        </button>\n                        <button class=\"embla__button embla__button--next\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "slider02-ap",
          "_isUserblock": true,
          "_cid": "v1761d99RE",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            "& when (@reverse)": {
              ".title__block": {
                "z-index": "5"
              }
            },
            ".figure when (@showFigure)": {
              "display": "block",
              "position": "relative",
              "z-index": "1",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "z-index": "-1",
                "width": "110px",
                "height": "110px",
                "bottom": "-85px",
                "left": "-105px",
                "background-image": "url(@figure)",
                "background-repeat": "no-repeat",
                "background-size": "cover"
              }
            },
            ".link": {
              "display": "block",
              "margin-bottom": "0",
              "white-space": "nowrap",
              "padding-right": "10px",
              "margin-top": "45px",
              "text-align": "right",
              "position": "relative",
              "z-index": "5",
              "a": {
                "font-weight": "700"
              },
              "span": {
                "display": "inline-block !important",
                "transition": "all 0.3s ease",
                "margin-left": "13px"
              },
              "&:hover span": {
                "transform": "translateX(9px)"
              }
            },
            "& when (@bgColor2)": {
              ".card__block:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "-128px",
                "left": "205px",
                "width": "100vw",
                "height": "~'calc(100% + 182px)'",
                "background-color": "@twoBgColor",
                "opacity": "@twoBgOpacity"
              }
            },
            ".card__item": {
              "max-width": "45%",
              "padding": "0 23px",
              "margin-bottom": "65px"
            },
            ".card__content": {
              "position": "relative",
              "width": "100%",
              "height": "280px",
              "transition": "all .3s ease",
              "&:hover": {
                "transform": "scale(0.95)"
              },
              "img": {
                "position": "absolute",
                "height": "100%",
                "width": "100%",
                "object-fit": "cover",
                "z-index": "0"
              },
              ".card__title": {
                "z-index": "5",
                "position": "relative",
                "padding": "28px 28px 7px",
                "margin-bottom": "0",
                "pointer-events": "none"
              },
              ".card__text": {
                "z-index": "5",
                "position": "relative",
                "padding": "0 28px",
                "margin-bottom": "0",
                "pointer-events": "none",
                "& when not (@cardTitle)": {
                  "padding-top": "28px"
                }
              },
              ".is-builder & .card__title": {
                "pointer-events": "all"
              },
              ".is-builder & .card__text": {
                "pointer-events": "all"
              }
            },
            "@media (max-width: 1024px)": {
              ".figure:before": {
                "width": "60px",
                "height": "60px",
                "bottom": "-100px",
                "left": "-15px"
              },
              ".link": {
                "margin-top": "15px",
                "padding-right": "0",
                "text-align": "left"
              },
              ".title__block": {
                "margin-bottom": "74px"
              },
              "& when (@bgColor2)": {
                ".card__block:before": {
                  "top": "-50px",
                  "left": "115px",
                  "height": "~'calc(100% + 90px)'"
                }
              },
              ".card__item": {
                "max-width": "348px",
                "margin": "0 auto 25px"
              }
            },
            "@media (max-width: 767px)": {
              ".card__block > [class*=\"col-\"]": {
                "padding-right": "5px",
                "padding-left": "5px"
              },
              ".card__content": {
                "height": "200px"
              },
              ".card__text": {
                "font-size": "14px",
                "line-height": "18px"
              }
            },
            "@media (max-width: 575px)": {
              ".card__item": {
                "max-width": "274px"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title, .link": {
              "text-align": "left"
            },
            ".card__content .card__title": {
              "text-align": "center"
            }
          },
          "_name": "features3",
          "_sourceTheme": "voyagem4",
          "_customHTML": "<section class=\"features3 voyagem4_features3 d-block d-md-none d-lg-block\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"checkbox\" title=\"Left/Right Content\" name=\"reverse\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<input type=\"checkbox\" title=\"Figure\" name=\"showFigure\" condition=\"showTitle\">\n\t\t<input type=\"image\" title=\"Figure\" name=\"figure\" value=\"@PROJECT_PATH@/assets/images/compass.svg\" condition=\"showFigure && showTitle\">\n\t\t\n\t\t<header>Card</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"cardTitle\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"cardText\">\n\t\t<select name=\"cardCount\" title=\"Count\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\" selected>2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\">6</option>\n\t\t</select>\n\t\t\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\">\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#c7cb05\" condition=\"overlay && bg.type !== 'color'\" checked>\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay && bg.type !== 'color'\" checked>\n\t\t\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"2 BG Color\" name=\"bgColor2\">\n\t\t<input type=\"color\" title=\"2 Background Color\" value=\"#ffffff\" name=\"twoBgColor\" condition=\"bgColor2\">\n\t\t<input type=\"range\" inline title=\"2 BG Opacity\" name=\"twoBgOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"bgColor2\">\n\t\t\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\n\t<div class=\"container\">\n\t\t<div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverse}\">\n\t\t\t<div class=\"col-lg-3 title__block\" mbr-if=\"showTitle || showButtons\">\n\t\t\t\t<h3 class=\"mbr-section-title figure mbr-fonts-style\" mbr-if=\"showTitle\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .link\">\n\t\t\t\t\tBrochures\n\t\t\t\t</h3>\n\t\t\t\t<p class=\"link mbr-fonts-style\" mbr-if=\"showButtons\" mbr-theme-style=\"display-4\" data-app-selector=\".link\"><a href=\"#\"><br></a>\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t\t<div class=\"col-lg-9 col-12\">\n\t\t\t\t<div class=\"row card__block\">\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/addon-342-677x381.jpg\" alt=\"szablon_trening\" title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\t<br><br><br>Italy\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\" mbr-if=\"cardCount > 1\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/addon-249-677x381.jpg\" alt=\"szablon_delivery\" title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\tSpain\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\t<br><br><br><br><br><br><br>Lorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\" mbr-if=\"cardCount > 2\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/voyage10.jpg\" alt title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\tGermany\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\" mbr-if=\"cardCount > 3\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/voyage11.jpg\" alt title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\tNorway\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\" mbr-if=\"cardCount > 4\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/voyage11.jpg\" alt title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\tFinland\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"col-lg-6 col-sm-6 col-12 card__item\" mbr-if=\"cardCount > 5\">\n\t\t\t\t\t\t<div class=\"card__content text-white\">\n\t\t\t\t\t\t\t<a href=\"index.html\"><img src=\"@PROJECT_PATH@/assets/images/voyage11.jpg\" alt title></a>\n\t\t\t\t\t\t\t<h5 class=\"card__title mbr-normal mbr-fonts-style\" mbr-if=\"cardTitle\" mbr-theme-style=\"display-5\" data-app-selector=\".card__content .card__title\">\n\t\t\t\t\t\t\t\tRussia\n\t\t\t\t\t\t\t</h5>\n\t\t\t\t\t\t\t<p class=\"card__text mbr-fonts-style\" mbr-if=\"cardText\" mbr-theme-style=\"display-4\" data-app-selector=\".card__content .card__text\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet, consectetur adipisicing elit.\n\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
