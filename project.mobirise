                  "height": "40px",
                  "font-size": "30px",
                  "color": "@icon"
                }
              },
              ".mbr-text": {
                "margin-bottom": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            ".mbr-text": {
              "color": "#444444",
              "text-align": "center"
            },
