        {
          "_name": "pricing1",
          "_sourceTheme": "snackm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            "h3, h4, h5, h6, p": {
              "margin": "0"
            },
            ".section-head": {
              "margin-bottom": "2.5rem"
            },
            ".mbr-section-subtitle": {
              "margin-top": "0.5rem"
            },
            ".card": {
              "background-color": "@cardBgColor",
              "border-radius": "25px",
              "border-style": "dashed",
              "padding": "2rem",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "space-between",
              "margin-bottom": "2rem",
              "border-width": "(@bordertWidth * 1px)",
              "border-color": "@borderColor",
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "flex-direction": "column"
              },
              "@media (max-width: 767px)": {
                "flex-direction": "column"
              },
              "& when not (@cardBg)": {
                "background": "transparent"
              },
              "& when not (@border)": {
                "border": "none"
              }
            },
            ".card-title": {
              "margin-bottom": "25px",
              "text-align": "center"
            },
            ".card-subtitle": {
              "color": "#33d5ad",
              "text-align": "left"
            },
            ".mbr-text": {
              "& when (@showCardSubtitle)": {
                "margin-bottom": "25px"
              }
            },
            ".list": {
              "list-style-type": "circle",
              "list-style-position": "inside",
              "margin-bottom": "0",
              "padding-left": "1rem",
              "li": {
                "margin-bottom": "0.3rem"
              },
              "text-align": "left"
            },
            ".price": {
              "display": "flex",
              "flex-direction": "column-reverse",
              "justify-content": "space-between",
              "align-items": "flex-end",
              "margin-left": "2rem",
              "& when not (@showButtons)": {
                "min-width": "204px",
                "justify-content": "flex-end"
              },
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "margin-top": "1rem"
              },
              "@media (max-width: 767px)": {
                "margin-top": "2rem"
              },
              "@media (max-width: 350px)": {
                "margin-left": "0",
                "align-items": "center"
              }
            },
            ".price-text-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "0"
            },
            ".line": {
              "width": "1px",
              "height": "50px",
              "margin": "0 20px",
              "background-color": "@lineColor",
              "opacity": "@lineOpacity",
              "& when not (@showLine)": {
                "opacity": "0"
              }
            },
            ".mbr-price-text": {
              "color": "#1f1437",
              "margin-bottom": "0"
            },
            ".mbr-price-number": {
              "color": "#000000",
              "margin-bottom": "0"
            },
            ".mbr-amount-text": {
              "color": "#1f1437",
              "margin-bottom": "0",
              "text-align": "center"
            },
            ".mbr-amount-number": {
              "color": "#000000",
              "margin-bottom": "0"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing1 d-none d-lg-block\" group=\"Pricing\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <header>Cards</header>\n        <select title=\"Amount\" name=\"cardsAmount\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <select title=\"Columns\" name=\"columns\">\n            <option value=\"12\" selected>1</option>\n            <option value=\"6\">2</option>\n            <option value=\"4\">3</option>\n            <option value=\"3\">4</option>\n            <option value=\"2\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Background\" name=\"cardBg\" checked>\n        <input type=\"color\" title=\"Color\" name=\"cardBgColor\" value=\"#fafafa\" condition=\"cardBg\">\n        <input type=\"checkbox\" title=\"Border\" name=\"border\" checked>\n        <input type=\"color\" title=\"Color\" name=\"borderColor\" value=\"#242424\" condition=\"border\">\n        <input type=\"range\" name=\"bordertWidth\" title=\"Width\" min=\"1\" max=\"5\" value=\"1\" step=\"1\" condition=\"border\">\n        <input type=\"color\" title=\"Color\" name=\"cardBg\" value=\"#e0e1d3\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showCardSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        \n        <input type=\"checkbox\" title=\"Price\" name=\"showDetails\" checked>\n        <input type=\"checkbox\" title=\"Line\" name=\"showLine\" condition=\"showDetails\" checked>\n        <input type=\"color\" title=\"Color\" name=\"lineColor\" value=\"#1f1437\" condition=\"showDetails && showLine\">\n        <input type=\"range\" title=\"Opacity\" name=\"lineOpacity\" min=\"0.1\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"showDetails && showLine\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\">\n        \n        \n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#efefef\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <div class=\"section-head align-center\" mbr-if=\"showTitle || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Title</b>\n                    </h3>\n                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        Subtitle</h4>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-md-6 col-lg-{{columns}}\">\n                        <div class=\"card\">\n                            <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\"><b>PAKIET FOCUS NA MARKETING&nbsp;</b></h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">Jednorazowy raport skuteczności po pierwszym miesiącu działania strony</li>\n                            <li class=\"item-wrap\">\n                                Test A/B raport efektywności strony - gdzie klikają? gdzie się gubią?</li><li class=\"item-wrap\">Rekomendacje + pełna dokumentacja&nbsp; działań</li>\n                        </ul>\n                                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-size btn-success\" href=\"index.html?zgloszenie-online\" data-app-placeholder=\"Type Text\">dostępny&nbsp;<strong></strong></a>dostępny</div>\n                    </div>\n                            <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">\n                                    CENA</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">750 zł</p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">\n                                    CZAS</p>\n                                \n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\">DO 5 DNI</p>\n                            </div>\n                        </div>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md-6 col-lg-{{columns}}\" mbr-if=\"cardsAmount > 1\">\n                        <div class=\"card\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>EXPRESS SHIPPING TO A RESIDENTIAL ADDRESS</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\n                                incididunt ut labore et dolore magna aliqua.\n                            </p>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-subtitle\" mbr-if=\"showCardSubtitle\">\n                                <b>FROM $10</b>\n                            </h6>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md-6 col-lg-{{columns}}\" mbr-if=\"cardsAmount > 2\">\n                        <div class=\"card\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>NEXT-DAY SHIPPING IS OFFERED TO SOME AREAS</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\n                                incididunt ut labore et dolore magna aliqua.\n                            </p>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-subtitle\" mbr-if=\"showCardSubtitle\">\n                                <b>FROM $15</b>\n                            </h6>\n                        </div>\n                    </div>\n                    <div class=\"col-md-6 col-lg-{{columns}}\" mbr-if=\"cardsAmount > 3\">\n                        <div class=\"card\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>STANDARD SHIPPING TO A RESIDENTIAL ADDRESS</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\n                                incididunt ut labore et dolore magna aliqua.\n                            </p>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-subtitle\" mbr-if=\"showCardSubtitle\">\n                                <b>FROM $5</b>\n                            </h6>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md-6 col-lg-{{columns}}\" mbr-if=\"cardsAmount > 4\">\n                        <div class=\"card\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>EXPRESS SHIPPING TO A RESIDENTIAL ADDRESS</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\n                                incididunt ut labore et dolore magna aliqua.\n                            </p>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-subtitle\" mbr-if=\"showCardSubtitle\">\n                                <b>FROM $10</b>\n                            </h6>\n                        </div>\n                    </div>\n                    <div class=\"col-12 col-md-6 col-lg-{{columns}}\" mbr-if=\"cardsAmount > 5\">\n                        <div class=\"card\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                <b>NEXT-DAY SHIPPING IS OFFERED TO SOME AREAS</b>\n                            </h5>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\">\n                                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor\n                                incididunt ut labore et dolore magna aliqua.\n                            </p>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-subtitle\" mbr-if=\"showCardSubtitle\">\n                                <b>FROM $15</b>\n                            </h6>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        \n    \n</div></div></section>",
          "_anchor": "pricing1-3x",
