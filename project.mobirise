                    "background-color": "@iconBg_3"
                  }
                },
                ".item-wrapper": {
                  "border-radius": "25px !important",
                  "background-color": "@card",
                  "height": "100%",
                  "padding": "30px",
                  "@media (max-width: 768px)": {
                    "padding": "20px 15px"
                  },
                  ".card-box": {
                    ".icon-wrapper": {
                      "text-align": "right",
