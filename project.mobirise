              },
              ".mbr-section-title": {
                "margin-bottom": "10px"
              },
              ".icon-wrapper": {
                ".mbr-iconfont": {
                  "display": "inline-flex",
                  "width": "40px",
                  "height": "40px",
                  "font-size": "40px",
                  "color": "@icon"
                }
              }
            },
