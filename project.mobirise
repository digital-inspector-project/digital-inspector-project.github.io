          "_name": "features8",
          "_sourceTheme": "tutorm5",
          "_customHTML": "<section class=\"tutorm5 features8\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n    <select title=\"Columns\" name=\"columns\">\n      <option value=\"12\">1</option>\n      <option value=\"6\">2</option>\n      <option value=\"4\" selected>3</option>\n      <option value=\"3\">4</option>\n    </select>\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n    <input type=\"checkbox\" title=\"Button\" name=\"showButton\">\n    <header>Step</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showCardText\" checked>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-24.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#faff00\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://www.youtube.com/watch?v=-BSQlJxCDcI\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-24.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n  </div>\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center\">\n      <div class=\"col-12 content-head\">\n        <div class=\"card-wrapper pb-3 mb-5\">\n          <div class=\"card-box align-center\">\n            <h4 class=\"mbr-section-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title, .card-box\">MÓJ MUST HAVE</h4>\n            <p class=\"mbr-maintext mbr-fonts-style mt-2\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".mbr-maintext, .mbr-section-btn\">Rozwiązania, dostosowane do klienta</p>\n            <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn mt-4\" data-toolbar=\"-mbrBtnMove\" mbr-if=\"showButton\"><a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Get Started&nbsp;</a></div>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"row end\">\n      <div class=\"col-lg-9\">\n        <div class=\"row content-row\">\n          <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb active\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">01</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\">\n                <b>Spójność z identyfikacją wizualną marki</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                Dopasowuje kolory, fonty i style graficzne do istniejącego wizerunku marki. Wprowadzam odpowiedni układ bloków.</p>\n            </div>\n          </div>\n          <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">02</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\">\n                <b>Funkcje dostosowane do specyfiki biznesu</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                Między innymi dedykowane rozwiązania funkcjonalne takie jak funkcje e-commerce dostosowane do produktu klienta.</p>\n            </div>\n          </div>\n          <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">03</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\"><b>Rozbudowane opcje SEO oparte o wyszukiwanie lokalne</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                Optymalizuje stronę pod kątem lokalnych wyszukiwań, np. „najlepszy salon kosmetyczny w [mieście].\n              </p>\n            </div>\n          </div>\n          <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">04</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\">\n                <b>Możliwość skalowania twojego unikalnego landing paga</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                Proponuje elastyczne rozwiązania umożliwiające łatwe dodawanie&nbsp; nowych funkcji lub integracji z narzędziami marketingowymi.\n              </p>\n            </div>\n          </div>\n          \n          <div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">05</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\">\n                <b>Budowanie emocji i unikalnych doświadczeń dla klienta</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">\n                Staram się stosować skuteczny storytelling, czyli tworzę stronę tak, aby opowiadała historię marki klienta w angażujący sposób.</p>\n            </div>\n          </div><div class=\"item features-without-image col-12 col-md-6 col-lg-{{columns}} item-mb\">\n            <div class=\"item-wrapper\" mbr-if=\"showCardTitle||showCardText\">\n              <div class=\"title mb-1\">\n                <span class=\"num mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-text data-app-selector=\".num\">06</span>\n              </div>\n              <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title, .card-img\"><b>Stosuję indywidualne podejście do każdego klienta</b></h4>\n              <p class=\"mbr-text card-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showCardText\" data-app-selector=\".card-text\">Moją przewagą jest empatia, indywidualne podejście i umiejętność tworzenia czegoś „od serca.” Oferuj klientom wartość, której nie znajdą w dużych, bezosobowych firmach.&nbsp;</p>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features8-q",
          "_isUserblock": true,
