          },
          "_customHTML": "<section class=\"countdown1 petsm4_countdown1\" group=\"Countdowns\" plugins=\"countdown\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n\t<mbr-parameters>\n\t\t<!-- Block parameters controls (Blue \"Gear\" panel) -->\n\t\t<input type=\"text\" title=\"Countdown\" name=\"countdown\" value=\"2025/11/30\">\n\t\t<input type=\"text\" inline title=\"Days\" name=\"daysCountdown\" value=\"DNI\">\n\t\t<input type=\"text\" inline title=\"Hours\" name=\"hoursCountdown\" value=\"GODZIN\">\n\t\t<input type=\"text\" inline title=\"Minutes\" name=\"minutesCountdown\" value=\"MINUT\">\n\t\t<input type=\"text\" inline title=\"Seconds\" name=\"secondsCountdown\" value=\"SEKUND\">\n\t\t<input type=\"color\" title=\"Numbers Color\" name=\"numbersColor\" value=\"#c7cb05\">\n\t\t<input type=\"color\" title=\"Labels Color\" name=\"labelsColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Countdown Background\" name=\"countdownBg\" value=\"#121212\">\n\t\t<!-- End block parameters -->\n\t</mbr-parameters>\n\n\t<div class=\"container-fluid pt-5 pb-5 full-count-container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"countdown-cont align-center col-md-10 col-lg-8\">\n\t\t\t\t<div title=\"{{daysCountdown}}\" class=\"daysCountdown col-xs-3 col-sm-3 col-md-3\"></div>\n\t\t\t\t<div title=\"{{hoursCountdown}}\" class=\"hoursCountdown col-xs-3 col-sm-3 col-md-3\"></div>\n\t\t\t\t<div title=\"{{minutesCountdown}}\" class=\"minutesCountdown col-xs-3 col-sm-3 col-md-3\"></div>\n\t\t\t\t<div title=\"{{secondsCountdown}}\" class=\"secondsCountdown col-xs-3 col-sm-3 col-md-3\"></div>\n\t\t\t\t<div class=\"countdown \" data-due-date=\"{{countdown}}\">\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
