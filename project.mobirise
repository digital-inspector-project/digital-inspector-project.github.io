        {
          "_name": "pricing2",
          "_sourceTheme": "snackm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)",
              "& when (@pattern)": {
                "background-repeat": "repeat",
                "background-size": "30px 30px"
              }
            },
            "h3, h4, h5, p": {
              "margin": "0"
            },
            ".section-head": {
              "margin-bottom": "2.5rem"
            },
            ".mbr-section-subtitle": {
              "margin-top": "0.5rem"
            },
            ".card": {
              "background-color": "@cardBgColor",
              "border-radius": "25px",
              "padding": "2rem",
              "display": "flex",
              "flex-direction": "row",
              "justify-content": "space-between",
              "margin-bottom": "2rem",
              "border-width": "(@bordertWidth * 1px)",
              "border-style": "dashed",
              "border-color": "@borderColor",
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "flex-direction": "column"
              },
              "@media (max-width: 767px)": {
                "flex-direction": "column"
              },
              "& when not (@cardBg)": {
                "background": "transparent"
              },
              "& when not (@border)": {
                "border": "none"
              }
            },
            ".card-title": {
              "margin-bottom": "25px",
              "text-align": "left"
            },
            ".card-subtitle": {
              "color": "#33d5ad"
            },
            ".list": {
              "list-style-type": "circle",
              "list-style-position": "inside",
              "margin-bottom": "0",
              "padding-left": "1rem",
              "li": {
                "margin-bottom": "0.3rem"
              }
            },
            ".price": {
              "display": "flex",
              "flex-direction": "column-reverse",
              "justify-content": "space-between",
              "align-items": "flex-end",
              "margin-left": "2rem",
              "& when not (@showButtons)": {
                "min-width": "204px",
                "justify-content": "flex-end"
              },
              "@media (min-width: 992px) and (max-width: 1199px)": {
                "margin-top": "1rem"
              },
              "@media (max-width: 767px)": {
                "margin-top": "2rem"
              },
              "@media (max-width: 350px)": {
                "margin-left": "0",
                "align-items": "center"
              }
            },
            ".price-text-wrap": {
              "display": "flex",
              "align-items": "center",
              "margin-left": "0"
            },
            ".line": {
              "width": "1px",
              "height": "50px",
              "margin": "0 20px",
              "background-color": "@lineColor",
              "opacity": "@lineOpacity",
              "& when not (@showLine)": {
                "opacity": "0"
              }
            },
            ".mbr-price-text": {
              "color": "#1f1437",
              "margin-bottom": "0"
            },
            ".mbr-price-number": {
              "color": "#000000",
              "margin-bottom": "0"
            },
            ".mbr-amount-text": {
              "color": "#1f1437",
              "margin-bottom": "0",
              "text-align": "center"
            },
            ".mbr-amount-number": {
              "color": "#000000",
              "margin-bottom": "0"
            }
          },
          "_customHTML": "<section class=\"pricing2\" group=\"Pricing\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" name=\"fullWidth\" title=\"Full Width\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <select title=\"Amount\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Background\" name=\"cardBg\" checked>\n        <input type=\"color\" title=\"Color\" name=\"cardBgColor\" value=\"#efefef\" condition=\"cardBg\">\n        <input type=\"checkbox\" title=\"Border\" name=\"border\" checked>\n        <input type=\"color\" title=\"Color\" name=\"borderColor\" value=\"#242424\" condition=\"border\">\n        <input type=\"range\" name=\"bordertWidth\" title=\"Width\" min=\"1\" max=\"5\" value=\"1\" step=\"1\" condition=\"border\">\n        <input type=\"checkbox\" title=\"Price\" name=\"showDetails\" checked>\n        <input type=\"checkbox\" title=\"Line\" name=\"showLine\" condition=\"showDetails\" checked>\n        <input type=\"color\" title=\"Color\" name=\"lineColor\" value=\"#1f1437\" condition=\"showDetails && showLine\">\n        <input type=\"range\" title=\"Opacity\" name=\"lineOpacity\" min=\"0.1\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"showDetails && showLine\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\">\n        \n        \n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay&&bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-if=\"showTitle || showSubtitle\">\n            <div class=\"col-12 col-md-{{textWidth}}\">\n                <div class=\"section-head align-center\" mbr-if=\"showTitle || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>Title</b>\n                    </h3>\n                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\">\n                        Subtitle</h4>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\"><b>MINI-PAKIET AUDYTOWY</b></h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">Audyt email-marketingowy</li>\n                            <li class=\"item-wrap\">\n                                Audyt&nbsp; stabilnego SEO</li><li class=\"item-wrap\">Pełna Dokumentacja&nbsp;</li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-size btn-success\" href=\"index.html?zgloszenie-online\" data-app-placeholder=\"Type Text\">dostepny<br><strong></strong></a></div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">\n                                    CENA</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">650 zł</p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">\n                                    CZAS</p>\n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\">DO 5 DNI</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\"><b>MINI-PAKIET OPIEKA I </b><br><b>ROZWÓJ WWW</b></h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">\n                                Monitoring bezpieczeństwa&nbsp;</li>\n                            <li class=\"item-wrap\">Prace aktualizacyjne&nbsp;</li>\n                            <li class=\"item-wrap\">Sugestie dotyczące usprawnień na stronie</li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\"><a class=\"btn btn-size btn-success\" href=\"index.html?zgloszenie-online\" data-app-placeholder=\"Type Text\">dostępny<strong></strong></a></div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">CENA</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">250 zł</p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">CZAS</p>\n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\">3 DNI</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                            <b>NEXT-DAY SHIPPING IS OFFERED TO SOME AREAS</b>\n                        </h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                            <a class=\"btn btn-size btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><strong>ADD</strong></a>\n                        </div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">PRICE</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">\n                                    <b>$80</b>\n                                </p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">AMOUNT\n                                </p>\n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\"><b>16</b>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                            <b>STANDARD SHIPPING TO A RESIDENTIAL ADDRESS</b>\n                        </h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                            <a class=\"btn btn-size btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><strong>ADD</strong></a>\n                        </div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">\n                                    PRICE</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">\n                                    <b>$70</b>\n                                </p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">\n                                    AMOUNT\n                                </p>\n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\"><b>15</b>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                            <b>EXPRESS SHIPPING TO A RESIDENTIAL ADDRESS</b>\n                        </h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                            <a class=\"btn btn-size btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><strong>ADD</strong></a>\n                        </div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">\n                                    PRICE</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">\n                                    <b>$60</b>\n                                </p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-amount-text\">\n                                    AMOUNT\n                                </p>\n                                <p class=\"mbr-amount-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount-number\"><b>12</b>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card\">\n                    <div class=\"card-text\">\n                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                            <b>NEXT-DAY SHIPPING IS OFFERED TO SOME AREAS</b>\n                        </h5>\n                        <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article mbr-if=\"showList\">\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                            <li class=\"item-wrap\">\n                                Lorem ipsum dolor sit amet\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"price\">\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                            <a class=\"btn btn-size btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\"><strong>ADD</strong></a>\n                        </div>\n                        <div class=\"price-text-wrap\" mbr-if=\"showDetails\">\n                            <div>\n                                <p class=\"mbr-price-text mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-price-text\">PRICE</p>\n                                <p class=\"mbr-price-number mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-price-number\">\n                                    <b>$80</b>\n                                </p>\n                            </div>\n                            <div class=\"line\"></div>\n                            <div>\n                                <p class=\"mbr-amount-text mbr-fonts-style\" m