                      "color": "@icon",
                      "font-size": "28px",
                      "transition": "all 0.3s ease-in-out"
                    }
                  },
                  ".card-title": {
                    "margin-bottom": "20px"
                  },
                  ".card-text": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-desc, .desc-wrapper": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".card-text": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features06 trackm5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <input type=\"color\" title=\"Description BG\" value=\"#20002e\" name=\"desc\" condition=\"showDesc\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#eeeef4\" name=\"border\" condition=\"showDesc\" selected>\n        <input type=\"color\" title=\"Container BG\" value=\"#20002e\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#ffffff\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG 1\" value=\"#c7cb05\" name=\"iconBg_1\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG 2\" value=\"#c7cb05\" name=\"iconBg_2\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG 3\" value=\"#c7cb05\" name=\"iconBg_3\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#ffffff\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n        \n\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-11.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"item features-without-image item-mb\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-success mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                Sprawdzone techniki Marketing Masters\n                            </h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                By jeszcze lepiej system mógł wyświetlać nasze reklamy i znajodować osoby które są w stanie wykonać działania na których ci zależy. Czy to jest przejście do koszyka,kasy lub złożenie zamówienia to, tak jak ustawiasz swoje targetowanie tak też system reklamowy będzie szukał.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-without-image item-mb\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-growing-chart mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                Profesjonalne narzędzia</h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                Jak to mówią \"czas to pieniądz\" dlatego tak istotnym czynnikiem jest używanie sprawdzonych programów i rozwiązań które zdecydowanie potrafią przyspieszyć naszą pracę praktycznie w każdej chwili aktywności w sieci.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-without-image item-mb\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-idea mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                Wsparcie mentorów\n                            </h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                W programie Marketing Masters Szkoły Performance Marketingu mam wyjątkową grupę na Discordzie, gdzie wymieniamy się swoimi doświaczeniami i problemami. Ten program to nie tylko same kursy ale również społeczność i kontak z wybitnymi mentorami branży. \n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4 card\">\n                <div class=\"content-wrapper\">\n                    <div class=\"desc-wrapper\">\n                        <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc, .desc-wrapper\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\">Digital Inspector to :</p>\n                    </div>\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Pracując<br></h2>\n                    <div class=\"image-wrapper\">\n                        <img src=\"@PROJECT_PATH@/assets/images/mbr-3-700x467.jpeg\" alt=\"digital-inspector\">\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"item features-without-image item-mb item-next\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-contact-form mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                Szczegółowy plan</h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                To doskonała forma w której już od pierwszego dnia mogę zacząć wnosić realną wartość dla firmy. Przygotowany plan pozwala na wykrycie wielu mankamentów i wdrożenie zaleceń naprawczych w nowczesnym marketingu pod kątem podejścia data-driven. \n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-without-image item-mb item-next\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-protect mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">Wspieram<br>Priorytetyzację</h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                Moje działania oparte są na podstawie priorytetów, w których po pierwsze skupiam się na tych które mogą przynieść największe korzyści z punktu widzenia roli czyli zwrotu z inwestycji i zaangażowaniu odbiorców.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"item features-without-image item-mb item-next\">\n                    <div class=\"item-wrapper\">\n                        <div class=\"card-box\">\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon class=\"mbr-iconfont mobi-mbri-responsive-2 mobi-mbri\"></span>\n                            </div>\n                            <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".card-title\" mbr-if=\"showCardTitle\">\n                                Rozwiązania Google\n                            </h4>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-text\" mbr-if=\"showText\">\n                                Obecnie, korzystam z architektury Google Workspace rozwiązań do tworzednia digital marketingu w tym Google Analytics 4, Google Tag Manager, Google Marchent Center, Google Search Console, Looker studio.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
