        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "background-color": "@bgColor",
            "& when (@showBgImg)": {
              "background-image": "radial-gradient(circle farthest-side at 160% 170%, #c17339, @bgColor2 40%, rgba(238, 189, 146, 0))"
            },
            "& when (@reverseContent)": {
              ".content-wrapper": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-form": {
              "@media (max-width: 991px)": {
                "padding-top": "2rem",
                ".dragArea": {
                  "display": "flex",
                  "flex-direction": "column",
                  "align-items": "center",
                  "max-width": "29rem",
                  "margin": "0 auto"
                }
              },
              "@media (min-width: 992px)": {
                "& when (@reverseContent)": {
                  "padding-left": "5.75rem"
                },
                "& when not (@reverseContent)": {
                  "padding-right": "5.75rem"
                }
              }
            },
            ".col-img": {
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "@media (max-width: 991px)": {
                "padding-top": "2rem"
              },
              "@media (min-width: 992px)": {
                "& when (@reverseContent)": {
                  "padding-right": "5.75rem"
                },
                "& when not (@reverseContent)": {
                  "padding-left": "5.75rem"
                }
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-title": {
              "color": "#002549",
              "width": "100%",
              "@media (max-width: 991px)": {
                "text-align": "center"
              }
            },
            ".text-container": {
              "margin-bottom": "2rem"
            },
            ".form-container": {
              "max-width": "20rem"
            },
            ".form-group": {
              "padding": "0 !important",
              "input": {
                "color": "#002549",
                "&::placeholder": {
                  "color": "#C3AFAD"
                },
                "&::-moz-placeholder": {
                  "color": "#C3AFAD"
                },
                "&:-moz-placeholder": {
                  "color": "#C3AFAD"
                },
                "&:-ms-input-placeholder": {
                  "color": "#C3AFAD"
                }
              }
            },
            ".form-control": {
              "font-size": "1.2rem !important",
              "padding": "0.5rem 1rem !important",
              "border": "1px solid transparent",
              "border-radius": "1.25rem",
              "background-color": "#fff",
              "text-align": "center"
            },
            ".mbr-section-btn": {
              "padding": "0 !important",
              "display": "flex",
              "margin-bottom": "1.2rem",
              "width": "100%",
              ".btn": {
                "width": "100%"
              }
            },
            "a.btn": {
              "height": "100%",
              "margin": "0",
              "padding": "14px 40px"
            },
            ".book-page1": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "z-index": "1",
              "background-color": "#ffffff",
              "background-image": "linear-gradient(135deg, #f0edeb, #ffffff)",
              "-webkit-transform-origin": "0 100%",
              "-ms-transform-origin": "0 100%",
              "transform-origin": "0 100%",
              "transition": "0.5s all",
              "transform-style": "preserve-3d"
            },
            ".book-page2": {
              "position": "absolute",
              "left": "0",
              "top": "0",
              "right": "0",
              "bottom": "0",
              "z-index": "2",
              "background-color": "#ffffff",
              "background-image": "linear-gradient(315deg, #d4c5c0, #ffffff)",
              "-webkit-transform-origin": "0 100%",
              "-ms-transform-origin": "0 100%",
              "transform-origin": "0 100%",
              "transition": "0.5s all",
              "transform-style": "preserve-3d"
            },
            ".image-wrapper": {
              "justify-content": "center",
              "display": "flex",
              "transition": "0.5s all",
              "transform-style": "preserve-3d",
              "position": "relative",
              "z-index": "5",
              "width": "80%",
              "img": {
                "width": "auto",
                "height": "auto",
                "max-width": "100%",
                "max-height": "100%",
                "position": "relative",
                "z-index": "4",
                "transition": "0.5s all",
                "transform-style": "preserve-3d"
              },
              "&:hover": {
                "transform": "rotateZ(-4deg)",
                "& img": {
                  "transform": "rotateZ(0)"
                },
                "& .book-page1": {
                  "transform": "rotateZ(4deg)"
                },
                "& .book-page2": {
                  "transform": "rotateZ(1.8deg)"
                }
              }
            },
            "@media (max-width: 991px)": {
              ".content-wrapper": {
                "flex-direction": "column-reverse"
              }
            },
            ".justify-content-center": {
              "align-items": "center"
            },
            ".mbr-section-title": {
              "color": "#ffffff",
              "text-align": "center"
            },
            "H1": {
              "text-align": "center",
              "color": "#b8bc10"
            }
          },
          "_name": "form1",
          "_sourceTheme": "edgem5",
          "_customHTML": "<section class=\"form1\" group=\"Forms\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\" plugins=\"formstyler, datepicker\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <input type=\"checkbox\" title=\"Background Image\" name=\"showBgImg\" checked>\n        <input type=\"color\" name=\"bgColor2\" title=\"Image Color\" value=\"#ffffff\" selected condition=\"showBgImg\">\n        <header>Background</header>\n        <input type=\"color\" name=\"bgColor\" title=\"Color\" value=\"#20002e\" selected>\n    <input type=\"hidden\" name=\"usedRecaptcha\" value=\"false\"></mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row content-wrapper justify-content-center\">\n            <div mbr-form class=\"col-lg-6 mbr-form col-form\">\n<!--Formbuilder Form-->\n<form action name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\">\n<div class=\"row\">\n<div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\"> Thanks for filling out the form! </div>\n<div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\"> Oops...! some problem! </div>\n</div>\n<div class=\"dragArea row\">\n<div class=\"col-12\">\n<h1 mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" class=\"mbr-section-title mbr-fonts-style mb-3\"> + 50 gotowych scenariuszy na poprawę produktywności online</h1>\n</div>\n<div class=\"col-12\">\n<p mbr-theme-style=\"display-7\" mbr-if=\"showText\" class=\"mbr-text mbr-fonts-style mb-0\"> Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. </p>\n</div>\n<div data-for=\"email\" class=\"col-lg-12 col-md-12 col-sm-12 form-group\">\n<input type=\"email\" name=\"email\" placeholder=\"Email\" data-form-field=\"email\" mbr-theme-style=\"display-7\" class=\"form-control\" required=\"required\" value>\n</div>\n<div class=\"col-12 col-md-auto mbr-section-btn\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"w-100 w-100 w-100 btn btn-primary\" data-app-placeholder=\"Type Text\">Pobierz [wkrótce dostępny]</a></div>\n</div>\n</form><!--Formbuilder Form-->\n</div>\n            <div class=\"col-lg-6 col-12 col-img\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/promocja%20za%20grosze-793x1121.png\" alt=\"jak-promować-małe-firmy\">\n                    <div class=\"book-page2\"></div>\n                    <div class=\"book-page1\"></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "form1-46",
          "_isUserblock": true,
          "_cid": "v0iqAQE96b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "pricing01",
          "_sourceTheme": "digitalm4",
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = \"color\")": {
              "background": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@gradientBg)": {
              ".back": {
                "background": "linear-gradient(45deg, @half, @half2)"
              }
            },
            "& when (@itemsCount = \"3\")": {
              ".plan": {
                "&:first-child": {
                  "padding-top": "20px",
                  "@media (max-width: 768px)": {
                    "padding-top": "0px"
                  },
                  ".plan-header": {
                    "border-radius": "4px 0 0 0"
                  },
                  ".plan-body": {
                    "border-radius": "0 0 4px 4px"
                  }
                },
                "&:last-child": {
                  "padding-top": "20px",
                  "@media (max-width: 768px)": {
                    "padding-top": "0px"
                  },
                  ".plan-header": {
                    "border-radius": "0 4px 0 0"
                  },
                  ".plan-body": {
                    "border-radius": "0 0 4px 4px"
                  }
                },
                "&:nth-child(2)": {
                  ".plan-header": {
                    "border-radius": "4px 4px 0 0"
                  }
                }
              }
            },
            ".badge": {
              "display": "inline-block",
              "border-radius": "10rem",
              "padding": "8px 14px 6px 14px",
              "color": "@primaryColor",
              "background-color": "fade(@badgeBg, 15%)",
              "margin-bottom": "26px"
            },
            ".badge.display-4": {
              "font-size": "11px",
              "line-height": "1.81",
              "letter-spacing": "0.5px"
            },
            ".back": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "~\"@{halfHeight}%\"",
              "background-color": "@half"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "font-weight": "600",
              "margin-bottom": "21px"
            },
            ".main-title": {
              "margin-bottom": "36px",
              "color": "#ffffff",
              "&.display-2": {
                "line-height": "1.375"
              },
              "text-align": "center"
            },
            ".main-text": {
              "color": "#ffffff",
              "&.display-4": {
                "line-height": "1.75"
              },
              "text-align": "center"
            },
            ".plan": {
              "word-break": "break-word",
              "display": "flex",
              "flex-direction": "column",
              "height": "fit-content",
              "position": "relative",
              "max-width": "330px",
              "padding-right": "0",
              "padding-left": "0",
              "transition": "all 0.3s",
              "border-radius": "4px",
              ".plan-header, .plan-body": {
                "background-color": "@priceBg"
              },
              ".plan-header": {
                "padding-top": "60px",
                "padding-left": "1rem",
                "padding-right": "1rem",
                ".plan-title": {
                  "color": "#000000"
                },
                ".plan-price": {
                  ".price-figure": {
                    "color": "#404040",
                    ".price-currency": {
                      "display": "inline-block",
                      "&.display-7": {
                        "font-size": "18px",
                        "line-height": "1"
                      }
                    },
                    ".price-value": {
                      "display": "inline-block",
                      "&.display-1": {
                        "font-size": "60px",
                        "line-height": "1"
                      }
                    },
                    ".price-duration": {
                      "display": "inline-block",
                      "&.display-4": {
                        "font-size": "16px",
                        "line-height": "1"
                      }
                    }
                  }
                }
              },
              ".plan-body": {
                "padding-bottom": "2rem",
                "box-shadow": "0px 5px 20px rgba(0, 0, 0, 0.04)",
                ".plan-list": {
                  ".list-group": {
                    ".list-group-item": {
                      "background-color": "@priceBg",
                      "position": "relative",
                      "-webkit-justify-content": "center",
                      "justify-content": "center",
                      "border": "0",
                      "color": "#606060",
                      "padding-top": "5px",
                      "padding-bottom": "5px",
                      "span": {
                        "font-weight": "600"
                      }
                    },
                    "&.display-4": {
                      "line-height": "1"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "padding-top": "45px",
                  "text-align": "center",
                  ".btn-sm": {
                    "padding": "0.6rem 4.4rem"
                  },
                  ".btn": {
                    "&.display-4": {
                      "font-size": "13px",
                      "line-height": "1"
                    },
                    "&-primary": {
                      "&:hover": {
                        "box-shadow": "0 0 0 5px rgba(132, 138, 189, 0.2) !important",
                        "-webkit-box-shadow": "0 0 0 5px rgba(132, 138, 189, 0.2) !important"
                      }
                    },
                    "padding": "18px 26px 16px"
                  }
                }
              }
            },
            "@media (max-width: 550px)": {
              ".price-figure": {
                "font-size": "4.25rem"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_customHTML": "<section group=\"Pricing Tables\" class=\"pricing01 digitalm4_pricing01\" data-bg-video=\"{{bg.type == 'video' &amp;&amp; bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\">\n\n    <mbr-parameters>\n        \n        <input inline=\"\" type=\"range\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <input inline=\"\" type=\"range\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"1\">\n        <header>Show / Hide</header>\n        <input type=\"checkbox\" title=\"Badge\" name=\"showBadge\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Main Title\" name=\"showMainTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Main Text\" name=\"showMainText\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <select title=\"Items Count\" name=\"itemsCount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected=\"\">3</option>\n        </select>\n        <input type=\"color\" title=\"Badge Bg Color\" name=\"badgeBg\" value=\"#848abd\" selected=\"\" condition=\"showBadge\">\n        <input type=\"checkbox\" title=\"Bg Gradient\" name=\"gradientBg\" checked=\"\">\n\n        <input type=\"range\" inline=\"\" title=\"Half BG Height\" name=\"halfHeight\" min=\"20\" max=\"150\" step=\"5\" value=\"70\">\n        <input type=\"color\" title=\"Half BG Color\" name=\"half\" value=\"#000000\">\n        <input type=\"color\" title=\"Half BG Color 2\" name=\"half2\" value=\"#20002e\" condition=\"gradientBg\">\n        <input type=\"color\" title=\"Price Bg Color\" name=\"priceBg\" value=\"#20002e\">\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background1-16-1920x1440.jpg\" parallax=\"\">\n            <input type=\"color\" title=\"Background Color\" value=\"#20002e\" selected=\"\">\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-22.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked=\"\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#1a1919\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        \n    </mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div class=\"back\"></div>\n\n    <div class=\"container\">\n        <div class=\"badge_wrap align-center\">\n            <h5 class=\"badge mbr-regular mbr-bold mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".badge, .badge_wrap\" mbr-if=\"showBadge\">OUR PRICING\n            </h5>\n        </div>\n        <h3 class=\"mbr-fonts-style mbr-section-subtitle align-center mbr-light pt-3\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n            OUR PRICING<br></h3>\n        <h4 class=\"main-title align-center mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".main-title\" mbr-if=\"showMainTitle\"><br>ZAPRASZAMY DO ODKRYWANIA NOWYCH WPISÓW NA BLOGU. ZNAJDZIESZ TU CODZIENNĄ DAWKĘ INSPIRUJĄCYCH POMYSŁÓW!<br><br></h4>\n\n        <p class=\"main-text align-center mbr-regular mbr-black mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".main-text\" mbr-if=\"showMainText\"><br>Jeśli masz dodatkowe pytania lub chcesz dostosować pakiet do swoich potrzeb, możesz dodać komentarz w dedykowanej sekcji po wyborze opcji. <br>Postaramy się dopasować ofertę do Twoich oczekiwań, o ile będzie to możliwe.<br></p>\n        \n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "pricing01-50",
          "_isUserblock": true,
          "_cid": "v0itpHBHeO",
