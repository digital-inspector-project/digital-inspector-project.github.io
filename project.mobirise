                }
              }
            },
            ".image-wrapper": {
              "display": "flex",
              "justify-content": "center",
              ".image-wrap": {
                "position": "relative",
                "border": "2px solid @border_2",
                "border-radius": "3rem !important",
                "width": "332px",
                "height": "690px",
                "display": "flex",
                "justify-content": "center",
                "background-color": "@border_2",
                "box-shadow": "25px 60px 60px @shadow",
                "&::before": {
                  "content": "''",
                  "position": "absolute",
                  "top": "16px",
                  "width": "98px",
                  "height": "28px",
                  "border-radius": "1rem",
                  "background-color": "@border_1",
                  "@media (max-width: 1200px)": {
                    "top": "13px",
                    "width": "68px",
                    "height": "22px"
                  }
                },
                "@media (max-width: 1200px)": {
                  "width": "232px",
                  "height": "460px"
                },
                "img": {
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "border": "7px solid @border_1",
                  "border-radius": "3rem !important"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
