                "@media (max-width: 992px)": {
                  "padding": "0 16px"
                }
              }
            },
            ".container": {
              "@media (max-width: 992px)": {
                "padding": "0 16px"
              }
            },
            ".title-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "margin-bottom": "80px",
              "@media (max-width: 992px)": {
                "margin-bottom": "36px",
                "display": "block"
              },
              ".mbr-section-title": {
                "-webkit-text-stroke-color": "@title",
                "-webkit-text-stroke-width": "0.2vw",
                "color": "transparent",
                "& when not (@showTags)": {
                  "width": "100%"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "32px"
                }
              },
              ".tags-wrapper": {
                "margin-bottom": "16px",
                "& when not (@showTitle)": {
                  "width": "100%"
                },
                ".tags-wrap": {
                  "display": "inline-flex",
                  "flex-wrap": "wrap",
                  "@media (max-width: 992px)": {
                    "flex-direction": "column"
                  },
                  ".mbr-tag": {
                    "border": "4px solid @tag",
                    "padding": "8px 22px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "margin": "0 0 16px 16px",
                    "border-radius": "100em",
                    "@media (max-width: 992px)": {
                      "margin": "0 0 16px 0"
                    }
                  }
                }
              }
            },
            ".item": {
              "margin-bottom": "48px",
              "@media (max-width: 992px)": {
                "margin-bottom": "24px"
              },
              ".item-wrapper": {
                ".card-box": {
                  ".card-title": {
                    "margin-bottom": "10px"
                  },
                  ".card-text": {
                    "margin-bottom": "0"
                  }
                }
              }
            },
            ".card-title": {
              "color": "#000000",
              "text-align": "left"
            },
            ".card-text": {
              "color": "#000000",
              "text-align": "left"
            },
            ".mbr-tag": {
              "color": "#898989"
            },
            ".mbr-section-title": {
              "text-align": "right"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article02 resumem5\" group=\"Article\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Title Color\" value=\"#080808\" name=\"title\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Tags\" name=\"showTags\">\n        <input type=\"range\" inline title=\"Tags Amount\" name=\"tags\" min=\"1&quot;\" max=\"3\" step=\"1\" value=\"1\" condition=\"showTags\">\n        <input type=\"color\" title=\"Border Color\" value=\"#898989\" name=\"tag\" condition=\"showTags\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n\t\t\t\t\t<input type=\"color\" title=\"Color\" value=\"#ffffff\">\n                    <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/dots.svg\" selected>\n\t\t\t</fieldset>\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n\t\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"checkbox\" title=\"Pattern\" name=\"pattern\" condition=\"bg.type !== 'color'\" checked>\n        \n        \n        \n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\" mbr-if=\"showTitle || showTags\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        Main components ↗\n                    </h2>\n                    <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                        <div class=\"tags-wrap\">\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag, .tags-wrapper\" mbr-theme-style=\"display-4\">\n                                About\n                            </p>\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag, .tags-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"tags > 1\">\n                                Skill\n                            </p>\n                            <p class=\"mbr-tag mbr-fonts-style\" data-app-selector=\".mbr-tag, .tags-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"tags > 2\">\n                                Content\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-7\">\n                <div class=\"items-wrapper\">\n                    \n                    <div class=\"item features-without-image item-mb active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>🟣 </b>Responsywny design – żadnego klikania w mikroskopijne linki</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Każdy, kto trafi na Twoją stronę, zobaczy ją w najlepszej formie – na telefonie, tablecie czy komputerze. Nie ma mowy o irytującym przewijaniu w bok ani szukaniu przycisku w złym miejscu.<br><br></p>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>🟣 </b>Logiczny układ i przyjazna nawigacja</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Nie musisz się martwić, że potencjalny klient „zgubi się” na stronie. Projektuję tak, aby prowadzić klienta krok po kroku do celu, którym jest zakup lub zapisanie się na listę mailingową.<br><br>\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\">🟣&nbsp;Pełna integracja z SEO</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Korzystasz z wcześniej opracowanej strategii i treści SEO ? Świetnie ! <br>Twój nowy landing page będzie z nią kompatybilny. Dbam o odpowiednie struktury nagłówków, meta-opisy i linkowanie wewnętrzne, tak&nbsp; aby wyszukiwarki wiedziały, że warto Cię promować.<br><br>\n                                </p>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-without-image item-mb\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"card-box\">\n                                <h4 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".card-title\"><b>🟣 </b>Szata graficzna premium dopasowana do marki</h4>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showText\" data-app-selector=\".card-text\">Projekt nie może wyglądać jak sztuczny, odklejony od Twojego stylu fragment marki. Bazując na Twoich kolorach, dopasowuje fonty, nagłówki, czyli unikalny design system zachowując charakter wizualnym, tak aby utrzymać spójność z całym wizerunkiem.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
