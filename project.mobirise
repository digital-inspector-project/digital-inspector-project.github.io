              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "20px",
                "@media (max-width: 992px)": {
                  "margin": "0"
                }
              },
              "@media (max-width: 992px)": {
                "margin": "0"
              },
              "img": {
                "height": "600px",
                "object-fit": "cover",
                "border-radius": "25px !important",
                "@media (max-width: 992px)": {
