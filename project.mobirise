        {
          "_name": "features10",
          "_sourceTheme": "socialm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "overflow": "hidden",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item-wrapper": {
              "position": "relative"
            },
            ".slide-content": {
              "position": "relative",
              "background": "transparent",
              "height": "100%",
              "display": "flex",
              "overflow": "visible",
              "flex-flow": "column nowrap"
            },
            ".mbr-section-btn": {
              "margin-top": "auto !important",
              "margin-left": "0",
              "margin-right": "0",
              "width": "auto",
              "display": "inline-block"
            },
            ".mbr-section-title": {
              "color": "#14142b",
              "text-align": "center",
              "margin-bottom": "24px"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-title": {
              "text-align": "left"
            },
            ".item-subtitle": {
              "text-align": "left"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "37%",
              "max-width": "596px",
              "@media (max-width: 768px)": {
                "max-width": "initial"
              }
            },
            "@media (max-width: 900px)": {
              ".embla__slide": {
                "min-width": "60%"
              }
            },
            "@media (max-width: 630px)": {
              ".embla__slide": {
                "min-width": "375px"
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "transition": "background-color 300ms ease, transform 300ms ease, -webkit-transform 300ms ease",
              "width": "74px",
              "height": "74px",
              "font-size": "22px",
              "border-radius": "50%",
              "top": "50%",
              "margin-top": "-1.5rem",
              "background-color": "transparent",
              "border": "1px solid #ffffff",
              "color": "#fff",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:disabled": {
                "cursor": "default",
                "display": "none"
              },
              "&.embla__button--prev": {
                "left": "0",
                "margin-left": "2.5rem"
              },
              "&.embla__button--next": {
                "right": "0",
                "margin-right": "2.5rem"
              }
            },
            ".mobi-mbri-arrow-prev": {
              "margin-right": "5px"
            },
            ".mobi-mbri-arrow-next": {
              "margin-left": "5px"
            },
            ".embla": {
              "position": "relative",
              "width": "100%"
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "padding-left": "0",
              "padding-right": "0"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".mbr-section-subtitle": {
              "text-align": "center",
              "color": "#8c8c95"
            },
            ".title-block": {
              "justify-content": "space-between",
              "margin-bottom": "32px",
              "align-items": "center",
              "padding-bottom": "56px",
              "max-width": "715px",
              "margin": "auto"
            },
            ".wrap-img": {
              "overflow": "hidden",
              "padding": "0px 20px 20px",
              "display": "flex",
              "justify-content": "center"
            },
            "img": {
              "width": "100%",
              "object-fit": "cover"
            },
            ".card-title": {
              "margin-bottom": "16px",
              "color": "#ffffff",
              "transition": "0.35s",
              "text-align": "left !important",
              "padding": "124px 0 0"
            },
            ".card-text": {
              "color": "#8c8c95",
              "text-align": "center"
            },
            "H3": {
              "color": "#1d1d1f",
              "text-align": "center"
            },
            ".card-wrapper": {
              "background-color": "#ffffff",
              "padding": "32px",
              "display": "flex",
              "position": "relative",
              "margin": "auto",
              "width": "100%",
              "cursor": "pointer",
              "height": "280px",
              "&:before": {
                "width": "100%",
                "height": "100%",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "content": "''",
                "background": "black",
                "opacity": "0",
                "z-index": "1",
                "pointer-events": "none",
                "transition": "all 0.3s"
              },
              "transition": "all 1s",
              "&:hover, &:focus-within": {
                ".card-box": {
                  "opacity": "1"
                },
                "&:before": {
                  "opacity": "0.6"
                }
              }
            },
            ".date": {
              "margin-bottom": "24px",
              "color": "#8c8c95"
            },
            ".link-title": {
              "display": "inline-block"
            },
            ".margin": {
              "margin-right": "14px"
            },
            ".article": {
              "display": "contents"
            },
            ".button-color": {
              "padding": "1rem 1.5625rem !important",
              "border-radius": "1000px !important",
              "display": "inline-block",
              "line-height": "20px",
              "background-color": "#eff0f6"
            },
            ".link-row": {
              "align-items": "center"
            },
            ".iconfont-wrapper": {
              "text-align": "left",
              "margin-bottom": "32px",
              ".mbr-iconfont::before": {
                "font-size": "50px",
                "padding": "25px",
                "border-radius": "50%"
              }
            },
            ".button-align": {
              "margin-top": "36px",
              "text-align": "center"
            },
            ".btn": {
              "margin-top": "20px"
            },
            ".card-title, .iconfont-wrapper": {
              "text-align": "center"
            },
            "a.btn > span": {
              "margin-left": "0.5rem"
            },
            ".card-box": {
              "position": "absolute",
              "padding-right": "30px",
              "margin": "auto",
              "opacity": "0",
              "transition": "opacity 0.35s, transform 0.35s, -webkit-transform 0.35s",
              "z-index": "3",
              "&:focus-within": {
                "opacity": "1"
              },
              "height": "100%",
              "display": "flex",
              "align-items": "flex-start"
            },
            ".card-img": {
              "border-radius": "0",
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "transition": "all 0.3s",
              "img": {
                "object-fit": "cover",
                "height": "100%",
                "width": "100%"
              },
              "max-height": "280px"
            },
            ".card-box1": {
              "opacity": "1",
              "position": "absolute",
              "z-index": "3",
              "left": "32px",
              "right": "32px"
            },
            ".card-title1": {
              "padding": "21px 0",
              "z-index": "3",
              "width": "100%",
              "color": "#ffffff",
              "text-align": "left"
            },
            ".card-wrapper:hover": {
              ".card-box": {
                "opacity": "1",
                "-webkit-transform": "translate3d(0, 0, 0)",
                "transform": "translate3d(0, 0, 0)",
                "transition": "opacity 0.35s, transform 0.35s, -webkit-transform 0.35s"
              },
              ".card-title1:after": {
                "opacity": "1",
                "transform": "translate3d(0, 0, 0)",
                "position": "absolute",
                "bottom": "0",
                "left": "0",
                "width": "100%",
                "height": "3px",
                "background": "#fff",
                "content": "''",
                "transition": "transform 0.35s, -webkit-transform 0.35s"
              }
            },
            ".card-title1:after": {
              "opacity": "0",
              "transform": "translate3d(-100%, 0, 0)",
              "transition": "transform 0.35s, -webkit-transform 0.35s",
              "position": "absolute",
              "bottom": "0",
              "left": "0",
              "width": "100%",
              "height": "3px",
              "background": "#fff",
              "content": "''"
            },
            ".card1": {
              "background-image": "url(@card1bg)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".card2": {
              "background-image": "url(@card2bg)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".card3": {
              "background-image": "url(@card3bg)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".card4": {
              "background-image": "url(@card4bg)",
              "background-size": "cover",
              "background-position": "center"
            },
            ".card5": {
              "background-image": "url(@card1bg)",
              "background-size": "cover",
              "background-position": "center"
            },
            "@media (max-width: 576px)": {
              ".embla__slide": {
                "min-width": "initial",
                "width": "100%",
                "margin-bottom": "30px",
                "margin-left": "0 !important",
                "margin-right": "0 !important"
              },
              ".embla__slide:last-child": {
                "margin-bottom": "0px"
              },
              ".embla__container": {
                "flex-direction": "column",
                "transform": "initial !important"
              },
              ".embla__button": {
                "display": "none"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features10 mbr-embla\" group=\"Features\" plugins=\"embla\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <input type=\"image\" name=\"card1bg\" title=\"Card 1 Bg\" value=\"@PROJECT_PATH@/assets/images/kompleksowo%20content%20i%20social%20media-1170x780.jpg\">\n        <input type=\"image\" name=\"card2bg\" title=\"Card 2 Bg\" value=\"@PROJECT_PATH@/assets/images/efektywne%20strony%20internetowe-1170x780.jpg\">\n        <input type=\"image\" name=\"card3bg\" title=\"Card 3 Bg\" value=\"@PROJECT_PATH@/assets/images/automatyzacja%20e-mail%20marketingu-400x300.jpg\">\n        <input type=\"image\" name=\"card4bg\" title=\"Card 4 Bg\" value=\"@PROJECT_PATH@/assets/images/kompleksowo%20content%20i%20social%20media-1170x780.jpg\">\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\" checked>\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\">\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" checked condition=\"arrows\">\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" required>\n            <input type=\"color\" title=\"Color\" value=\"#20002e\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/mbr-1920x1005.png\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{\n        'mbr-fullscreen': fullScreen}\">\n        <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n            <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                <div class=\"embla__viewport\">\n                    <div class=\"embla__container\">\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"card-img card1\">\n                                </div>\n                                <div class=\"card-box\">\n                                    <h4 class=\"card-title mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Usprawniamy proces tworzenia, optymalizacji i dystrybucji treści. Czyli oszczędzamy czas, poprawiamy widoczność i zwiększamy zaangażowanie.</h4>\n                                </div>\n                                <div class=\"card-box1\">\n                                    <h4 class=\"card-title1 mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">\n                                        CONTENT I SOCIAL MEDIA</h4>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"card-img card2\">\n                                </div>\n                                <div class=\"card-box\">\n                                    <h4 class=\"card-title mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Strona jest dynamicznie dostosowywana, aby zwiększać współczynnik konwersji i ROI.&nbsp; Dzięki integracji z narzędziami marketingowymi, strona aktywnie wspiera cele kampanii.</h4>\n                                </div>\n                                <div class=\"card-box1\">\n                                    <h4 class=\"card-title1 mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">BŁYSKAWICZNY WEB DESIGN</h4>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"card-img card3\">\n                                </div>\n                                <div class=\"card-box\">\n                                    <h4 class=\"card-title mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Automatyczne wysyłanie spersonalizowanych wiadomości e-mail do potencjalnych klientów.</h4>\n                                </div>\n                                <div class=\"card-box1\">\n                                    <h4 class=\"card-title1 mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">\n                                        LEAD GENERATION</h4>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"embla__slide slider-image item features-image\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                            <div class=\"card-wrapper\">\n                                <div class=\"card-img card4\">\n                                </div>\n                                <div class=\"card-box\">\n                                    <h4 class=\"card-title mbr-white mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">Automatyczne generowanie reklam na podstawie feedów produktowych za pomocą narzędzi takich jak Google Merchant Center czy dynamiczne reklam.</h4>\n                                </div>\n                                <div class=\"card-box1\">\n                                    <h4 class=\"card-title1 mbr-white mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title1\">TWORZENIE I OPTYMALIZACJA KAMAPNII</h4>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n                <button class=\"embla__button embla__button--prev\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-prev mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Previous</span>\n                </button>\n                <button class=\"embla__button embla__button--next\">\n                    <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\" aria-hidden=\"true\"></span>\n                    <span class=\"sr-only visually-hidden visually-hidden\">Next</span>\n                </button>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features10-54",
          "_isUserblock": true,
          "_cid": "v0iuHYFdPt",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afeatures3",
          "_sourceTheme": "orderm5",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              ".second-bg-color": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@secondColor",
                "border-top-left-radius": "4.1666666667vw",
                "border-top-right-radius": "4.1666666667vw"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            ".text-wrapper": {
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#FFFFFF",
              "@media (max-width: 991px)": {
                "text-align": "center !important"
              },
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#FFFFFF",
              "margin-right": "auto",
              "margin-top": "1rem",
              "@media (max-width: 991px)": {
                "text-align": "center !important"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "1rem",
              "@media (max-width: 991px)": {
                "text-align": "center !important"
              }
            },
            ".custom-section-btn": {
              ".btn": {
                "padding": "2.5vw 5vw",
                "@media (max-width: 991px)": {
                  "padding": "24px 42px"
                }
              },
              ".btn-primary": {
                "border": "1px solid #FFFFFF !important",
                "&:hover": {
                  "border": "1px solid #FFFFFF !important"
                }
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#333333"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3 orderm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#20002e\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background3-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#ffffff\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title align-right mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        LET'S AUTOMATE YOUR WORKFLOWS\n                    </h1>\n                    <p class=\"mbr-text mbr-fonts-style align-right mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Blog MASTERS</p>\n                    <div mbr-buttons mbr-theme-style=\"display-5\" class=\"mbr-section-btn align-right custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <div class=\"btn-transform\">GET STARTED</div>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "afeatures3-51",
          "_isUserblock": true,
          "_cid": "v0itszGg1e",
