        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'color')": {
              "& when (@bgGradient)": {
                "background": "linear-gradient(45deg, @bg-value, @bgColor2)"
              },
              "& when not (@bgGradient)": {
                "background": "@bg-value"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".carousel-item": {
              "justify-content": "flex-start",
              "text-align": "center",
              ".mbr-section-subtitle": {
                "color": "#232332"
              },
              ".btn": {
                "margin": "0.4rem !important",
                "justify-content": "space-between",
                "&.btn-sm": {
                  "padding": "9px 41px"
                }
              },
              "img": {
                "width": "100%",
                "-o-object-fit": "contain",
                "object-fit": "contain",
                "margin-top": "2rem"
              }
            },
            ".carousel-item.active, .carousel-item-next, .carousel-item-prev": {
              "display": "flex"
            },
            ".carousel-controls": {
              "a": {
                "transition": "opacity .5s",
                "width": "5%",
                "span": {
                  "position": "absolute",
                  "top": "45%",
                  "font-size": "40px",
                  "padding": "15px",
                  "border-radius": "50%",
                  "color": "@arrowColor",
                  "background": "transparent"
                },
                "&:hover": {
                  "span": {
                    "opacity": "1"
                  }
                }
              },
              "@media (max-width: 992px)": {
                "display": "none"
              }
            },
            ".carousel-indicators": {
              "margin": "20px auto 0",
              "align-items": "center",
              "position": "relative",
              ".active": {
                "opacity": "1",
                "border": "0",
                "background-color": "@activeIndicator"
              },
              "li": {
                "height": "10px",
                "width": "10px",
                "border-radius": "50%",
                "transition": "opacity .5s",
                "background-color": "@inActiveIndicator",
                "font-size": "2rem",
                "opacity": ".5",
                "border": "1px solid #dddfe0",
                "&:hover": {
                  "opacity": "1"
                }
              }
            },
            "@media (max-width: 768px)": {
              "*": {
                "text-align": "center"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            }
          },
          "_name": "features3",
          "_sourceTheme": "directm4",
          "_customHTML": "<section class=\"carousel slide testimonials-slider features3 directm4_features3 slider\" group=\"Features\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax, 'mbr-fullscreen': fullScreen}\" plugins=\"BootstrapCarouselSwipe,mbr-testimonials-slider\" data-interval=\"false\">\n\n\t<mbr-parameters>\n\t\t\n\t\t<header>Size</header>\n\t\t<input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n\t\t<input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n\t\t<input type=\"range\" title=\"Padding Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"0\" inline condition=\"!fullScreen\">\n\t\t<input type=\"range\" title=\"Padding Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"0\" inline condition=\"!fullScreen\">\n\t\t<input type=\"range\" inline title=\"Count Items\" name=\"testimonialsSlides\" min=\"1\" max=\"4\" step=\"1\" value=\"4\">\n\t\t<input type=\"checkbox\" title=\"Autoplay\" name=\"showAutoplay\" checked>\n\t\t<input type=\"range\" inline title=\"Autoplay Interval (ms)\" name=\"interval\" min=\"1000\" max=\"8000\" step=\"1000\" value=\"3000\" condition=\"showAutoplay\">\n\t\t<header>Show / Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showSlideTitle\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSlideSubTitle\">\n\t\t<input type=\"checkbox\" title=\"Text\" name=\"showSlideText\">\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showSlideButtons\">\n\t\t<input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n\t\t<header>Colors</header>\n\t\t<input type=\"color\" title=\"Arrows\" name=\"arrowColor\" value=\"#ffffff\">\n\t\t<input type=\"color\" title=\"Active Bullet\" name=\"activeIndicator\" value=\"#b7ba01\">\n\t\t<input type=\"color\" title=\"Inactive Bullet\" name=\"inActiveIndicator\" value=\"#b7ba01\">\n\t\t<hr>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Background Image\" value=\"@PROJECT_PATH@/assets/images/background2-1.jpg\">\n\t\t\t<input type=\"color\" title=\"Background Color\" value=\"#efefef\" selected>\n\t\t\t<input type=\"video\" title=\"Background Video\" value=\"https://youtu.be/iM-NestDPNQ\">\n\t\t</fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-6.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\n\t\t<input type=\"checkbox\" title=\"BG Gradient\" name=\"bgGradient\" condition=\"bg.type=='color'\" checked>\n\t\t<input type=\"color\" title=\"BG Color 2\" name=\"bgColor2\" value=\"#efefef\" condition=\"bg.type=='color' && bgGradient\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0\" condition=\"overlay&&bg.type !== 'color'\">\n\t\t\n\t</mbr-parameters>\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\n\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n\t</div>\n\n\t<div class=\"text-center\" mbr-class=\"{'container-fluid': fullWidth, 'container': !fullWidth }\">\n\t\t<div class=\"carousel slide\" role=\"listbox\" data-pause=\"true\" data-keyboard=\"false\" data-ride=\"{{showAutoplay ? 'carousel' : 'false'}}\" data-interval=\"{{showAutoplay ? interval : 'false'}}\" mbr-class=\"{'pt-3': showTitle}\">\n\t\t\t<div mbr-list mbr-list-grow=\"testimonialsSlides\" class=\"carousel-inner\">\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"container\">\n\t\t\t\t\t\t<div class=\"col-md-10 col-12 offset-0 offset-md-1\">\n\t\t\t\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSlideSubTitle\" data-app-selector=\".carousel-item .mbr-section-subtitle, .carousel-item .mbr-section-btn\">\n\t\t\t\t\t\t\t\tLorem ipsum</h3>\n\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSlideTitle\" data-app-selector=\".carousel-item .mbr-section-title, .carousel-item .mbr-section-btn\">\n\t\t\t\t\t\t\t\tLorem ipsum dolor sit amet\n\t\t\t\t\t\t\t</h1>\n\t\t\t\t\t\t\t<p class=\"mbr-text mbr-regular mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSlideText\" data-app-selector=\".carousel-item .mbr-text, .carousel-item .mbr-section-btn\">Fusce\n\t\t\t\t\t\t\t\tdapibus,\n\t\t\t\t\t\t\t\ttellus ac cursus commodo, tortor mauris condimentum nibh, ut fermentum massa justo sit\n\t\t\t\t\t\t\t\tamet risus. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur\n\t\t\t\t\t\t\t\tridiculus mus.</p>\n\t\t\t\t\t\t\t<div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showSlideButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-sm btn-danger\" href=\"https://mobirise.co\" data-app-placeholder=\"Type Text\">SHOP\n\t\t\t\t\t\t\t\t\tNOW</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/1-1740x1059.png\" alt=\"photo1\" mbr-if=\"showImage\">\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\n\t\t\t\t<div class=\"carousel-item\">\n\t\t\t\t\t<div class=\"container\">\n\t\t\t\t\t\t<div class=\"col-md-10 col-12 offset-0 offset-md-1\">\n\t\t\t\t\t\t\t<h3 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSlideSubTitle\" data-app-selector=\".carousel-item .mbr-section-subtitle, .carousel-item .mbr-section-btn\">\n\t\t\t\t\t\t\t\tLorem ipsum\n\t\t\t\t\t\t\t</h3>\n\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style\" mbr-th